#!/usr/bin/env bash
# pk — Pipekit v2 daily-loop dispatcher
#
# North star: safe and frictionless. Helps, never adds work.
#
# All subcommands are idempotent against Linear+git ground truth.
# Recovery = rerun the command. Read state, decide what's left, do only that.
#
# Subcommands:
#   pk next                 — what should I do now? (Linear + git → next command)
#   pk status               — quick triage of in-flight + UAT + Approved
#   pk branch <ID>          — create worktree+branch, Linear → In Progress
#   pk ship [--env=<env>]   — push, gh pr create, Linear → UAT
#   pk done                 — verify PR merged, cleanup worktree+branch (no state change)
#   pk verify               — light verify (run test cmd from method.config.md)
#   pk config [<key>]       — read a V2 key from method.config.md (or dump all)
#   pk promote <env>        — promote one hop along Ship environments; transitions
#                             matching issues → Released (intermediate) or Done (final)
#   pk delegate <ID> <txt>  — post @Linear-mentioned comment to delegate work
#   pk spec-cycle <ID>      — trigger Spec Review Agent v5, poll, dispatch on verdict
#
# Linear access: GraphQL via $LINEAR_API_KEY (env var name configurable in
# method.config.md → "Linear API key env var"). If absent, scripts that need
# Linear print a clear "set LINEAR_API_KEY" and exit.

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Discovery & configuration
# ─────────────────────────────────────────────────────────────────────────────

PK_VERSION="2.7.0"

pk_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

pk_config_path() {
  local root
  root=$(pk_repo_root) || return 1
  echo "$root/method.config.md"
}

# Read a value from method.config.md by label. Accepts two formats:
#
#   1) Plain Key: Value lines inside any fenced code block (current style,
#      used by Piper, rs-vault, and the consumer-facing examples in
#      method.config.template.md):
#
#        ```
#        Backend: auto
#        Ship environments: dev,beta,main
#        ```
#
#   2) Legacy markdown-table rows (still rendered for documentation):
#
#        | **Backend** | `native` | ... |
#
# Code-block form is tried first since that is what consumers actually set.
# Falls back to the table form, then to the supplied default.
pk_config() {
  local label="$1"
  local default="${2:-}"
  local path
  path=$(pk_config_path) || { echo "$default"; return 0; }
  [ -f "$path" ] || { echo "$default"; return 0; }

  # Form 1: `Key: Value` inside a fenced code block.
  local value
  value=$(awk -v label="$label" '
    /^```/        { in_fence = !in_fence; next }
    !in_fence     { next }
    {
      # Strip leading whitespace.
      sub(/^[[:space:]]+/, "")
      # Match "Label:" at start of line (case-sensitive, exact label).
      pos = index($0, ":")
      if (pos == 0) next
      key = substr($0, 1, pos - 1)
      if (key != label) next
      val = substr($0, pos + 1)
      # Trim whitespace + surrounding backticks (some configs quote values).
      sub(/^[[:space:]]+/, "", val)
      sub(/[[:space:]]+$/, "", val)
      gsub(/`/, "", val)
      print val
      exit
    }
  ' "$path" 2>/dev/null || true)

  if [ -n "$value" ]; then
    echo "$value"
    return 0
  fi

  # Form 2: legacy markdown-table row `| **Label** | value | ... |`.
  local line
  line=$(grep -E "^\| \*\*${label}\*\*" "$path" 2>/dev/null | head -1 || true)
  if [ -n "$line" ]; then
    value=$(echo "$line" | awk -F'|' '{print $3}' | sed 's/`//g; s/\*\*//g; s/^ *//; s/ *$//')
    if [ -n "$value" ]; then
      echo "$value"
      return 0
    fi
  fi

  echo "$default"
}

# Resolve integration branch with fallback chain.
pk_integration_branch() {
  local cfg
  cfg=$(pk_config "Integration branch" "")
  if [ -n "$cfg" ]; then
    echo "$cfg"
    return 0
  fi
  if git show-ref --verify --quiet refs/remotes/origin/dev 2>/dev/null; then
    echo "dev"
    return 0
  fi
  git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main"
}

pk_linear_api_key_var() {
  pk_config "Linear API key env var" "LINEAR_API_KEY"
}

# Resolve worktree path prefix. Trailing char in the config value controls
# join style: `-` → sibling-dir (~/Projects/foo-RS-30-x), `/` → subdir
# ($root/.worktrees/RS-30-x). Default keeps backward-compat with projects
# that never set the key.
pk_worktree_prefix() {
  local p
  p=$(pk_config "Worktree prefix" "")
  if [ -z "$p" ]; then
    echo "$(pk_repo_root)/.worktrees/"
    return 0
  fi
  case "$p" in
    "~/"*) p="$HOME/${p#\~/}" ;;
    "~")   p="$HOME" ;;
  esac
  echo "$p"
}

pk_linear_api_key() {
  local var
  var=$(pk_linear_api_key_var)
  local val
  # Priority for secrets: project-local > process env > empty.
  # This protects against a stale-inherited process env (e.g. Claude Code
  # bash subshell launched before the user fixed their key) overriding
  # the authoritative project-local key.
  # Order: .env.local (private overrides) → .env (project defaults) → $VAR.
  local root
  root=$(pk_repo_root) || root=""
  if [ -n "$root" ]; then
    for f in "$root/.env.local" "$root/.env"; do
      if [ -f "$f" ]; then
        val=$(grep -E "^(export +)?${var}=" "$f" 2>/dev/null | tail -1 | sed -E "s/^(export +)?${var}=//; s/^['\"]//; s/['\"]$//")
        if [ -n "$val" ]; then
          echo "$val"
          return 0
        fi
      fi
    done
  fi
  # Last resort: process env. Useful for ambient overrides + projects without .env.
  val=$(eval echo "\${$var:-}")
  if [ -n "$val" ]; then
    echo "$val"
    return 0
  fi
  echo ""
}

pk_team_name() {
  pk_config "Team name" ""
}

pk_team_id() {
  pk_config "Team ID" ""
}

pk_issue_prefix() {
  pk_config "Issue prefix" ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Linear GraphQL helpers
# ─────────────────────────────────────────────────────────────────────────────

pk_linear_gql() {
  local query="$1"
  local variables="${2:-}"
  [ -z "$variables" ] && variables='{}'
  local key
  key=$(pk_linear_api_key)
  if [ -z "$key" ]; then
    echo "ERROR: Linear API key not set. Configure via method.config.md → 'Linear API key env var' or export LINEAR_API_KEY=..." >&2
    return 1
  fi
  curl -sS -X POST https://api.linear.app/graphql \
    -H "Authorization: $key" \
    -H "Content-Type: application/json" \
    --data "$(jq -n --arg q "$query" --argjson v "$variables" '{query:$q, variables:$v}')"
}

# Get issue by identifier (e.g. "RS-30"). Prints JSON.
# Minimal field set — only fields callers (cmd_branch, cmd_ship) actually use.
pk_linear_issue() {
  local id="$1"
  local q='query($id: String!) { issue(id: $id) { id identifier title } }'
  pk_linear_gql "$q" "$(jq -n --arg id "$id" '{id:$id}')" | jq -r '.data.issue // empty'
}

# Read the current phase name from .vbw-planning/PHASES.md by extracting
# the heading text after "## Current Phase:". Returns empty if no PHASES.md
# or no current-phase heading. Used by phase-aware pk next.
pk_current_phase_name() {
  local root phases
  root=$(pk_repo_root)
  phases="$root/.vbw-planning/PHASES.md"
  [ -f "$phases" ] || return 0
  grep -m1 -E '^## Current Phase:' "$phases" 2>/dev/null \
    | sed -E 's/^## Current Phase:[[:space:]]*//; s/[[:space:]]+$//'
}

# Match the current phase name to a linear-map.json project entry and return
# its Linear project ID (UUID). Returns empty if no match.
#
# Matching is fuzzy because PHASES.md and linear-map.json may use different
# separators ("Phase 2.5 — Vault Redesign" vs "Phase 2.5: Vault Redesign").
# Strategy: normalize both sides to a "phase-key" by extracting the leading
# "Phase X.Y" or "Phase X" token and lowercasing the rest for substring match.
pk_current_phase_project_id() {
  local root map name
  root=$(pk_repo_root)
  map="$root/.vbw-planning/linear-map.json"
  [ -f "$map" ] || return 0
  name=$(pk_current_phase_name)
  [ -z "$name" ] && return 0
  # Extract leading phase token (e.g. "Phase 2.5" from "Phase 2.5 — Foo")
  local phase_token
  phase_token=$(echo "$name" | grep -oE '^Phase [0-9]+(\.[0-9]+)?' | head -1)
  jq -r --arg name "$name" --arg token "$phase_token" '
    .projects // {} | to_entries | map(.value)
    | map(select(
        .name == $name
        or ($token != "" and (.name | startswith($token)))
      ))
    | .[0].id // empty
  ' "$map" 2>/dev/null
}

# Get issues in a state for the current team, scoped to a Linear project ID.
# Same shape as pk_linear_issues_in_state but adds project filter. Empty
# project_id falls back to the unscoped query.
pk_linear_issues_in_state_project() {
  local state="$1" project_id="$2"
  local team
  team=$(pk_team_name)
  if [ -z "$team" ]; then
    echo "ERROR: Team name not set in method.config.md" >&2
    return 1
  fi
  if [ -z "$project_id" ]; then
    pk_linear_issues_in_state "$state"
    return $?
  fi
  local q='query($team: String!, $state: String!, $project: ID!) { issues(filter: {team: {name: {eq: $team}}, state: {name: {eq: $state}}, project: {id: {eq: $project}}}, orderBy: updatedAt, first: 25) { nodes { identifier title state { name } } } }'
  pk_linear_gql "$q" "$(jq -n --arg team "$team" --arg state "$state" --arg project "$project_id" '{team:$team, state:$state, project:$project}')" \
    | jq -r '.data.issues.nodes // []'
}

# Get issues in a state for current team. State name like "Approved".
pk_linear_issues_in_state() {
  local state="$1"
  local team
  team=$(pk_team_name)
  if [ -z "$team" ]; then
    echo "ERROR: Team name not set in method.config.md" >&2
    return 1
  fi
  local q='query($team: String!, $state: String!) { issues(filter: {team: {name: {eq: $team}}, state: {name: {eq: $state}}}, orderBy: updatedAt, first: 25) { nodes { identifier title state { name } } } }'
  pk_linear_gql "$q" "$(jq -n --arg team "$team" --arg state "$state" '{team:$team, state:$state}')" \
    | jq -r '.data.issues.nodes // []'
}

# Rank a Linear workflow state along the canonical forward ladder.
# Higher rank = further along the lifecycle. Unknown states return 0
# (treated as "before everything" so a callsite using --advance will
# always allow the transition — preserves current behavior for projects
# with custom workflows). Terminal-but-off-ladder states (Canceled,
# Duplicate) return a sentinel rank that never matches a target.
pk_state_rank() {
  local state="$1"
  # Hardcoded pre-deploy ladder (ranks 1-10).
  case "$state" in
    'Triage')        echo 1;  return ;;
    'Ideas')         echo 2;  return ;;
    'Future Phases') echo 3;  return ;;
    'On Deck')       echo 4;  return ;;
    'Needs Spec')    echo 5;  return ;;
    'Specced')       echo 6;  return ;;
    'Approved')      echo 7;  return ;;
    'Building')      echo 8;  return ;;
    'In Progress')   echo 9;  return ;;
    'UAT')           echo 10; return ;;
    'Done')          echo 50; return ;;
    'Canceled')      echo 99; return ;;
    'Duplicate')     echo 99; return ;;
  esac
  # Post-merge "In <env>" states (v2.5.0). Rank by position in Ship
  # environments chain — first env after preview = 11, next = 12, etc.
  # Generalizes to any project topology (dev,beta,main / develop,staging,
  # production / etc.) without hardcoded names. Unknown "In <env>" names
  # (env not in the chain) return 0 so they fall through the leap-frog
  # check the same way as fully-unknown states — preserves the "allow
  # transition for custom workflows" semantic.
  case "$state" in
    'In '*)
      local env_name env_lower chain idx=0 found=-1 e
      env_name="${state#In }"
      env_lower=$(echo "$env_name" | tr '[:upper:]' '[:lower:]')
      chain=$(pk_config "Ship environments" "")
      if [ -z "$chain" ]; then
        echo 0
        return
      fi
      local IFS=','
      for e in $chain; do
        e=$(echo "$e" | tr -d ' ')
        if [ "$e" = "$env_lower" ]; then
          found=$idx
          break
        fi
        idx=$((idx + 1))
      done
      if [ "$found" -ge 0 ]; then
        echo $((11 + found))
      else
        echo 0
      fi
      return
      ;;
  esac
  echo 0
}

# Capitalize the first letter of a word ("dev" → "Dev"). Used to derive
# state names ("In Dev", "In Beta", ...) from Ship environments entries
# which are lowercase by convention.
pk_capitalize() {
  echo "$1" | awk '{print toupper(substr($1,1,1)) substr($1,2)}'
}

# Linear state name for "just merged to the first deploy env" (v2.5.0).
# n-tier:  "In <FirstEnv-Capitalized>"  (e.g. "In Dev")
# 1-tier:  "Done"  (first env == final env; nothing more to promote to)
pk_first_env_state_name() {
  local chain envs_arr=()
  chain=$(pk_config "Ship environments" "")
  if [ -z "$chain" ]; then
    echo "Done"
    return
  fi
  IFS=',' read -ra envs_arr <<< "$chain"
  if [ ${#envs_arr[@]} -le 1 ]; then
    echo "Done"
    return
  fi
  local first
  first=$(echo "${envs_arr[0]}" | tr -d ' ')
  echo "In $(pk_capitalize "$first")"
}

# Linear state name for a given env target in a promote hop (v2.5.0).
# Intermediate hops: "In <Env-Capitalized>"
# Final env in chain: "Done"
# env not in chain: "" (caller should treat as error)
pk_env_state_name() {
  local env="$1"
  local chain envs_arr=()
  chain=$(pk_config "Ship environments" "")
  if [ -z "$chain" ]; then
    echo "Done"
    return
  fi
  IFS=',' read -ra envs_arr <<< "$chain"
  local last_idx=$((${#envs_arr[@]} - 1))
  local idx=0 e env_trim
  env_trim=$(echo "$env" | tr -d ' ')
  for e in "${envs_arr[@]}"; do
    e=$(echo "$e" | tr -d ' ')
    if [ "$e" = "$env_trim" ]; then
      if [ "$idx" -eq "$last_idx" ]; then
        echo "Done"
      else
        echo "In $(pk_capitalize "$env_trim")"
      fi
      return
    fi
    idx=$((idx + 1))
  done
  echo ""
}

# Fetch the current workflow-state name for a Linear issue by identifier.
# Empty string on lookup failure (network, missing issue, missing API key) so
# callers can treat absence as "don't know" without aborting. Used by the
# UAT-state code refusals in cmd_done / cmd_promote (v2.4.3).
pk_linear_get_state() {
  local id="$1"
  local issue_q='query($id: String!) { issue(id: $id) { state { name } } }'
  pk_linear_gql "$issue_q" "$(jq -n --arg id "$id" '{id:$id}')" 2>/dev/null \
    | jq -r '.data.issue.state.name // empty' 2>/dev/null
}

# Update issue state by identifier + state name.
#
# Modes:
#   (default)   idempotent set — skip if already in target, otherwise mutate
#   "advance"   ladder-gated: only mutate when target rank > current rank;
#               refuse Approved-or-earlier → Released/Done leap-frogs with
#               a warning (these imply commits shipped without verification).
pk_linear_set_state() {
  local id="$1"
  local state_name="$2"
  local mode="${3:-}"
  # Filter workflowStates by team NAME (reliable — pk_team_name reads
  # method.config.md robustly). Earlier versions used team.id.eq with
  # pk_team_id, but Team ID may be empty in many configs and the filter
  # silently returned no states, masquerading as "state not found".
  local team_name
  team_name=$(pk_team_name)
  if [ -z "$team_name" ]; then
    echo "ERROR: Team name not set in method.config.md" >&2
    return 1
  fi
  local state_q='query($team: String!, $name: String!) { workflowStates(filter: {team: {name: {eq: $team}}, name: {eq: $name}}) { nodes { id name } } }'
  local state_id
  state_id=$(pk_linear_gql "$state_q" "$(jq -n --arg team "$team_name" --arg name "$state_name" '{team:$team, name:$name}')" \
    | jq -r '.data.workflowStates.nodes[0].id // empty')
  if [ -z "$state_id" ]; then
    echo "ERROR: state '$state_name' not found in Linear team" >&2
    return 1
  fi
  # Resolve issue UUID from identifier
  local issue_q='query($id: String!) { issue(id: $id) { id state { name } } }'
  local resp
  resp=$(pk_linear_gql "$issue_q" "$(jq -n --arg id "$id" '{id:$id}')")
  local current_state issue_uuid
  current_state=$(echo "$resp" | jq -r '.data.issue.state.name // empty')
  issue_uuid=$(echo "$resp" | jq -r '.data.issue.id // empty')
  if [ -z "$issue_uuid" ]; then
    echo "ERROR: issue $id not found" >&2
    return 1
  fi
  # Idempotent: skip if already in target state
  if [ "$current_state" = "$state_name" ]; then
    echo "  Linear: $id already in '$state_name' (skip)"
    return 0
  fi
  # Ladder gate (opt-in via mode="advance"): forward-only along the canonical
  # workflow. Prevents promote bundles from pulling Done WITs backward and
  # from leap-frogging Approved WITs past the verification states.
  if [ "$mode" = "advance" ] && [ -n "$current_state" ]; then
    local rank_current rank_target rank_approved
    rank_current=$(pk_state_rank "$current_state")
    rank_target=$(pk_state_rank "$state_name")
    rank_approved=$(pk_state_rank "Approved")
    # Unknown current OR target → fall through to mutate (preserve current
    # behavior for projects with custom workflow states off the canonical ladder).
    if [ "$rank_current" -gt 0 ] && [ "$rank_target" -gt 0 ]; then
      if [ "$rank_target" -lt "$rank_current" ]; then
        echo "  Linear: $id already at '$current_state' (target was '$state_name') — skip backward transition"
        return 0
      fi
      # Leap-frog: current is Approved-or-earlier AND target is a post-merge
      # state (rank 11+ — any "In <env>" or Done). The WIT's commits made it
      # into a promote bundle without UAT/In Progress — surface it loudly
      # and refuse the transition. Threshold 11 = first env after UAT in
      # the v2.5.0 ladder (UAT=10, In <FirstEnv>=11).
      if [ "$rank_current" -le "$rank_approved" ] && [ "$rank_target" -ge 11 ]; then
        echo "  Linear: $id at '$current_state' — refusing leap-frog to '$state_name'." >&2
        echo "    Commits shipped without Building/In Progress/UAT. Review manually before transitioning." >&2
        return 0
      fi
    fi
  fi
  local mutation='mutation($id: String!, $state: String!) { issueUpdate(id: $id, input: {stateId: $state}) { success } }'
  pk_linear_gql "$mutation" "$(jq -n --arg id "$issue_uuid" --arg state "$state_id" '{id:$id, state:$state}')" >/dev/null
  echo "  Linear: $id $current_state → $state_name"
}

pk_linear_comment() {
  local id="$1"
  local body="$2"
  local issue_q='query($id: String!) { issue(id: $id) { id } }'
  local issue_uuid
  issue_uuid=$(pk_linear_gql "$issue_q" "$(jq -n --arg id "$id" '{id:$id}')" \
    | jq -r '.data.issue.id // empty')
  if [ -z "$issue_uuid" ]; then
    echo "ERROR: issue $id not found" >&2
    return 1
  fi
  local mutation='mutation($issue: String!, $body: String!) { commentCreate(input: {issueId: $issue, body: $body}) { success } }'
  pk_linear_gql "$mutation" "$(jq -n --arg issue "$issue_uuid" --arg body "$body" '{issue:$issue, body:$body}')" >/dev/null
  echo "  Linear: comment posted on $id"
}

# Return the issue's tier (quick|standard|heavy) by scanning Linear labels for
# the first `tier:*` match. Defaults to "standard" when no label is set or the
# Linear lookup fails — keeps the v2.7 verify-complete.md gate operative even
# when Linear is unreachable. Mirrors the label-scan logic in skills/work/skill.md.
pk_linear_tier() {
  local id="$1"
  local q='query($id: String!) { issue(id: $id) { labels { nodes { name } } } }'
  local tier
  tier=$(pk_linear_gql "$q" "$(jq -n --arg id "$id" '{id:$id}')" 2>/dev/null \
    | jq -r '.data.issue.labels.nodes[]?.name // empty' 2>/dev/null \
    | grep -oE '^tier:(quick|standard|heavy)$' | head -1 | sed 's/^tier://')
  echo "${tier:-standard}"
}

# ─────────────────────────────────────────────────────────────────────────────
# Git / worktree helpers
# ─────────────────────────────────────────────────────────────────────────────

pk_current_branch() {
  git branch --show-current 2>/dev/null
}

# Extract issue ID from current branch name. Looks for <PREFIX>-<digits> anywhere.
pk_branch_issue_id() {
  local branch
  branch=$(pk_current_branch)
  local prefix
  prefix=$(pk_issue_prefix)
  # `|| true` because under `set -euo pipefail`, grep with no matches exits 1
  # and pipefail propagates that through the pipeline, killing the script.
  # Empty output is the correct "no issue ID found" signal here.
  if [ -n "$prefix" ]; then
    { echo "$branch" | grep -oE "${prefix}-[0-9]+" | head -1; } || true
  else
    { echo "$branch" | grep -oE "[A-Z]+-[0-9]+" | head -1; } || true
  fi
}

pk_worktree_path() {
  local id="$1"
  local root
  root=$(pk_repo_root)
  echo "$root/.worktrees/${id}"
}

# Symlink parent env files into a worktree (idempotent). Two passes:
#   (1) Root-level config + env files — the historical set.
#   (2) Nested per-app env files (monorepo: apps/web/.env.local, packages/*/.env).
# A fresh worktree checks out tracked files only; gitignored env files live in
# the parent and never appear here, so the app falls back to its *.example
# placeholder (e.g. NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co) and the
# browser client has no real backend to talk to. Pass (2) mirrors every real
# nested env file at the same relative path. Exact-name match (never *.example),
# pruning node_modules/.git/.worktrees so we never recurse into a dependency
# tree or a sibling worktree.
pk_link_env_files() {
  local root="$1" wt_path="$2" envf abs rel
  for envf in .env .env.local .env.dev .env.prod .envrc .mcp.json .sentryclirc; do
    if [ -f "$root/$envf" ] && [ ! -e "$wt_path/$envf" ]; then
      ln -sf "$root/$envf" "$wt_path/$envf"
    fi
  done
  while IFS= read -r abs; do
    [ -n "$abs" ] || continue
    rel="${abs#"$root"/}"
    case "$rel" in */*) ;; *) continue ;; esac   # root-level handled above
    if [ ! -e "$wt_path/$rel" ]; then
      mkdir -p "$wt_path/$(dirname "$rel")"
      ln -sf "$abs" "$wt_path/$rel"
    fi
  done < <(find "$root" \( -name node_modules -o -name .git -o -name .worktrees \) -prune \
             -o -type f \( -name .env -o -name .env.local -o -name .env.dev -o -name .env.prod \) -print 2>/dev/null)
}

# Classify whether a WIT identifier has real implementation evidence in git
# history reachable from <ref> (default HEAD). Echoes: built | docs-only | none.
# Doc-only paths (*.md, Logs/, docs/, Strategy/, CHANGELOG) do not count as
# implementation. Heuristic: assumes commits/merges reference the WIT id
# (Pipekit's feature/<ID>-slug convention puts it in the merge commit). Used by
# `pk doctor` to flag false-ships — issues the board calls Done/UAT but git
# never built. The id-boundary `([^0-9]|$)` stops WIT-49 matching WIT-497.
pk_git_build_evidence() {
  local id="$1" ref="${2:-HEAD}" files nondoc
  files=$(git log "$ref" -E --grep="${id}([^0-9]|$)" --name-only --pretty=format: 2>/dev/null \
    | grep -v '^$' | sort -u || true)
  if [ -z "$files" ]; then
    echo "none"; return 0
  fi
  nondoc=$(echo "$files" | grep -vE '\.md$|^Logs/|^docs/|^Strategy/|CHANGELOG' || true)
  if [ -z "$nondoc" ]; then
    echo "docs-only"
  else
    echo "built"
  fi
}

# Slugify issue title — lowercase, replace non-alnum with -, collapse, trim,
# keep first 3 words. Short slugs keep status bars and worktree paths sane.
# Stop words removed up-front (and, the, of, for, in, on, to, with) so the
# 3-word window lands on meaningful tokens. e.g. "Wire Microsoft SSO sign-in
# into /login (app-side)" → "wire-microsoft-sso", not "wire-microsoft-sso-
# sign-in-into-login-app-side".
pk_slug() {
  local title="$1"
  echo "$title" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/\b(and|the|of|for|in|on|to|with|into|a|an)\b//g; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -d- -f1-3
}

# gh CLI uses GraphQL by default; when rate-limited it returns empty results
# that look identical to "PR not found". These helpers retry through the REST
# API (separate, more generous rate limit bucket) when GraphQL fails or is
# empty. See alpha.13 backlog: gh REST fallback.
pk_gh_repo_slug() {
  # Parse owner/repo from git remote — pure local, no API call.
  # Critical: this helper supports the REST-fallback path, which fires
  # precisely when GraphQL is exhausted, so it cannot itself call GraphQL.
  local url
  url=$(git remote get-url origin 2>/dev/null) || return 1
  echo "$url" | sed -E 's#^.*github\.com[:/]##; s#\.git$##'
}

# Look up a PR by head branch. Output: JSON {state, url, number} or empty.
# state is normalized to GraphQL shape (OPEN / CLOSED / MERGED).
#
# Prefers REST over GraphQL. The REST quota (5000/hr) is a separate bucket
# from GraphQL's, and `gh pr view` (GraphQL) was burning quota on every
# successful pk call — multiple worktrees + repeated `pk status` exhausted
# the GraphQL pool mid-day. REST returns the same data with no downside.
# GraphQL is kept as a fallback only for the case where REST fails (network,
# auth, etc.) — not for rate-limit recovery in the other direction.
pk_gh_pr_view() {
  local branch="$1"
  local slug
  slug=$(pk_gh_repo_slug)
  if [ -n "$slug" ]; then
    local owner="${slug%%/*}"
    local rest
    rest=$(gh api "repos/${slug}/pulls?head=${owner}:${branch}&state=all&per_page=1" 2>/dev/null | jq -c '.[0] // empty' 2>/dev/null)
    if [ -n "$rest" ]; then
      echo "$rest" | jq -c '{
        state: (if .merged_at then "MERGED" elif .state == "open" then "OPEN" else "CLOSED" end),
        url: .html_url,
        number: .number
      }'
      return 0
    fi
  fi
  # REST returned nothing — try GraphQL as last resort.
  local result
  result=$(gh pr view "$branch" --json state,url,number 2>/dev/null || true)
  if [ -n "$result" ] && [ "$result" != "null" ]; then
    echo "$result"
  fi
}

# Create a PR. Args: --base X --head Y --title T --body B. Outputs the PR URL.
#
# Prefers REST (5000/hr quota, separate bucket from GraphQL). Caller must
# ensure the head branch is pushed to origin first; pk ship and pk promote
# both do this. GraphQL kept as fallback for non-rate-limit failures.
pk_gh_pr_create() {
  local base head title body draft=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)  base="$2";  shift 2 ;;
      --head)  head="$2";  shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --body)  body="$2";  shift 2 ;;
      --draft) draft=true; shift ;;
      *) echo "pk_gh_pr_create: unknown arg $1" >&2; return 2 ;;
    esac
  done
  local slug
  slug=$(pk_gh_repo_slug)
  if [ -n "$slug" ]; then
    local rest_url rest_err
    rest_err=$(mktemp)
    if $draft; then
      # REST API: `draft` is a boolean field. Use -F (raw) not -f (string)
      # so gh api passes it as JSON boolean rather than string "true".
      rest_url=$(gh api -X POST "repos/${slug}/pulls" \
        -f title="$title" -f head="$head" -f base="$base" -f body="$body" \
        -F draft=true \
        --jq '.html_url' 2>"$rest_err")
    else
      rest_url=$(gh api -X POST "repos/${slug}/pulls" \
        -f title="$title" -f head="$head" -f base="$base" -f body="$body" \
        --jq '.html_url' 2>"$rest_err")
    fi
    if [ -n "$rest_url" ]; then
      rm -f "$rest_err"
      echo "$rest_url"
      return 0
    fi
    # REST failed — surface error and try gh CLI as last resort.
    echo "REST pr create failed: $(tail -1 "$rest_err")" >&2
    rm -f "$rest_err"
  fi
  local out gh_args=(pr create --base "$base" --head "$head" --title "$title" --body "$body")
  $draft && gh_args+=(--draft)
  if out=$(gh "${gh_args[@]}" 2>&1); then
    echo "$out" | grep -oE 'https://[^ ]+' | head -1
    return 0
  fi
  echo "$out" >&2
  return 1
}

# Find the VBW PLAN.md for an issue ID across all phase dirs. Flexible
# match — VBW-native flat layout is .vbw-planning/phases/<phase>/<phase-num>-<id-num>-PLAN.md,
# but consumers may use alt nested layouts. Returns first match or empty.
pk_vbw_find_plan() {
  local root="$1"
  local issue="$2"
  [ -d "$root/.vbw-planning/phases" ] || return 1
  local id_num
  id_num=$(echo "$issue" | grep -oE '[0-9]+$' || echo "")
  [ -z "$id_num" ] && return 1
  local f
  # Native flat: phases/<phase>/<phase-num>-<id-num>-PLAN.md
  for f in "$root"/.vbw-planning/phases/*/*-"${id_num}"-PLAN.md; do
    if [ -f "$f" ]; then
      echo "$f"
      return 0
    fi
  done
  # Alt nested: phases/<phase>/<slug>-<id>/PLAN.md
  for f in "$root"/.vbw-planning/phases/*/*"${issue}"*/PLAN.md; do
    if [ -f "$f" ]; then
      echo "$f"
      return 0
    fi
  done
  return 1
}

# v2.6.0 #2: After a confirmed pk done merge, flip the PLAN.md frontmatter
# status from "ready" to "complete" and write a SUMMARY.md alongside.
# Unblocks fresh-worktree edits for batch flows by removing the stale
# "active plan" marker that VBW's file-guard treats as in-progress.
# Idempotent — re-runs are safe (existing SUMMARY.md is kept; status flip
# is no-op if already complete). Skips silently when no .vbw-planning/ or
# no matching PLAN.md exists.
pk_vbw_finalize_plan() {
  local root="$1"
  local issue="$2"
  local pr_url="$3"
  local merge_sha="$4"
  local commits_count="$5"
  local diffstat="$6"

  local plan_file
  plan_file=$(pk_vbw_find_plan "$root" "$issue") || return 1

  # Flip PLAN status: ready → complete (frontmatter-scoped). Awk because
  # sed -i is non-portable across BSD/GNU; awk gives us safe replacement
  # bounded to the leading `---` block.
  if grep -q "^status: ready$" "$plan_file" 2>/dev/null; then
    local tmp
    tmp=$(mktemp)
    awk '
      NR==1 && /^---$/ { in_fm=1; print; next }
      in_fm && /^---$/ { in_fm=0; print; next }
      in_fm && /^status: ready$/ { print "status: complete"; next }
      { print }
    ' "$plan_file" > "$tmp" && mv "$tmp" "$plan_file"
  fi

  # Write SUMMARY.md (idempotent — skip if exists).
  local summary_file="${plan_file%-PLAN.md}-SUMMARY.md"
  if [ ! -f "$summary_file" ]; then
    local today
    today=$(date +%Y-%m-%d)
    cat > "$summary_file" <<SUMMARY
---
status: shipped
issue: ${issue}
pr: ${pr_url}
merged: ${merge_sha}
commits: ${commits_count}
closed: ${today}
---

# Shipped — ${issue}

- PR: ${pr_url}
- Merge commit: \`${merge_sha}\`
- Commits shipped: ${commits_count}
- Diff: ${diffstat:-n/a}
- Closed: ${today}
SUMMARY
  fi

  # Print the relative paths so the user can see what was touched.
  local plan_rel summary_rel
  plan_rel="${plan_file#$root/}"
  summary_rel="${summary_file#$root/}"
  echo "$plan_rel"
  echo "$summary_rel"
  return 0
}

# ─────────────────────────────────────────────────────────────────────────────
# Subcommands
# ─────────────────────────────────────────────────────────────────────────────

cmd_next() {
  local current
  current=$(pk_current_branch)
  local issue
  issue=$(pk_branch_issue_id)
  if [ -n "$issue" ]; then
    # On a feature branch — show in-flight state
    echo "On branch: $current"
    echo "Issue: $issue"
    local pr_state
    pr_state=$(pk_gh_pr_view "$current")
    if [ -n "$pr_state" ]; then
      local state url
      state=$(echo "$pr_state" | jq -r '.state')
      url=$(echo "$pr_state" | jq -r '.url')
      echo "PR: $state — $url"
      case "$state" in
        OPEN)   echo ""; echo "Next: review/merge the PR, then  pk done" ;;
        MERGED) echo ""; echo "Next: pk done" ;;
        CLOSED) echo ""; echo "Next: PR closed without merge — investigate, then  pk done  to clean up" ;;
      esac
    else
      echo "PR: not opened yet"
      echo ""
      echo "Next: /work $issue   (or  pk ship  if work is done)"
    fi
    return 0
  fi
  # Not on a feature branch — find next Approved
  local integration
  integration=$(pk_integration_branch)
  if [ "$current" != "$integration" ] && [ "$current" != "main" ]; then
    echo "Current branch: $current (not feature, not integration)"
    echo "Switch to $integration first:  git checkout $integration"
    return 0
  fi
  # Phase-aware mode if PHASES.md + linear-map.json are present and a
  # current phase is defined. Falls back to the global "next Approved
  # anywhere" behaviour when no phase context is available.
  local phase_name phase_project
  phase_name=$(pk_current_phase_name)
  phase_project=$(pk_current_phase_project_id)

  if [ -n "$phase_name" ] && [ -n "$phase_project" ]; then
    echo "On $current — Phase: $phase_name"
    echo ""
    local in_progress approved needs_spec ip_count ap_count ns_count
    in_progress=$(pk_linear_issues_in_state_project "In Progress" "$phase_project" 2>/dev/null || echo "[]")
    approved=$(pk_linear_issues_in_state_project "Approved" "$phase_project" 2>/dev/null || echo "[]")
    needs_spec=$(pk_linear_issues_in_state_project "Needs Spec" "$phase_project" 2>/dev/null || echo "[]")
    ip_count=$(echo "$in_progress" | jq 'length')
    ap_count=$(echo "$approved" | jq 'length')
    ns_count=$(echo "$needs_spec" | jq 'length')

    if [ "$ip_count" -gt 0 ]; then
      echo "In Progress ($ip_count):"
      echo "$in_progress" | jq -r '.[] | "  \(.identifier) — \(.title)"'
      echo ""
    fi
    if [ "$ap_count" -gt 0 ]; then
      echo "Approved — ready for pk branch ($ap_count):"
      echo "$approved" | jq -r '.[] | "  \(.identifier) — \(.title)"'
      local next_id
      next_id=$(echo "$approved" | jq -r '.[0].identifier')
      echo ""
      echo "Run:  pk branch $next_id"
      echo ""
    fi
    if [ "$ns_count" -gt 0 ]; then
      echo "Needs Spec — run /light-spec to advance ($ns_count):"
      echo "$needs_spec" | jq -r '.[] | "  \(.identifier) — \(.title)"'
      echo ""
      if [ "$ap_count" = "0" ]; then
        local first_ns
        first_ns=$(echo "$needs_spec" | jq -r '.[0].identifier')
        echo "Run:  /light-spec $first_ns   (or batch the queue)"
        echo ""
      fi
    fi
    if [ "$ip_count" = "0" ] && [ "$ap_count" = "0" ] && [ "$ns_count" = "0" ]; then
      echo "Phase $phase_name has no In Progress / Approved / Needs Spec issues."
      echo "Check  pk status  for the full board, or update PHASES.md to the next phase."
    fi

    # Other phases — surface Approved work outside current phase
    local global_approved global_count outside_count
    global_approved=$(pk_linear_issues_in_state "Approved" 2>/dev/null || echo "[]")
    global_count=$(echo "$global_approved" | jq 'length')
    outside_count=$((global_count - ap_count))
    if [ "$outside_count" -gt 0 ]; then
      echo "Other phases: $outside_count Approved issue(s) outside current phase. Use  pk status  to see all."
    fi
    return 0
  fi

  # Legacy fallback — no phase context available
  echo "On $current — looking for next Approved issue in Linear..."
  local approved count
  approved=$(pk_linear_issues_in_state "Approved" 2>/dev/null || echo "[]")
  count=$(echo "$approved" | jq 'length')
  if [ "$count" = "0" ]; then
    echo "No Approved issues. Check  pk status  for the full board."
    return 0
  fi
  local next_id next_title
  next_id=$(echo "$approved" | jq -r '.[0].identifier')
  next_title=$(echo "$approved" | jq -r '.[0].title')
  echo "Next: $next_id — $next_title"
  echo ""
  echo "Run:  pk branch $next_id"
  if [ "$count" -gt 1 ]; then
    echo ""
    echo "($count Approved issues total. Use  pk status  to see all.)"
  fi
}

cmd_status() {
  local team
  team=$(pk_team_name)
  if [ -z "$team" ]; then
    echo "ERROR: Team name not set in method.config.md" >&2
    return 1
  fi
  echo "── Linear: $team ──"
  # Pre-deploy + UAT buckets are universal.
  local states=("In Progress" "Building" "UAT" "Approved")
  # Append "In <env>" buckets for every non-final env in Ship environments
  # (v2.5.0). Final env's state is "Done" — not shown in `pk status` since
  # it's terminal, not in-flight.
  local chain envs_arr=()
  chain=$(pk_config "Ship environments" "")
  if [ -n "$chain" ]; then
    IFS=',' read -ra envs_arr <<< "$chain"
    local last_idx=$((${#envs_arr[@]} - 1))
    local idx=0 e
    for e in "${envs_arr[@]}"; do
      e=$(echo "$e" | tr -d ' ')
      if [ "$idx" -lt "$last_idx" ]; then
        states+=("In $(pk_capitalize "$e")")
      fi
      idx=$((idx + 1))
    done
  fi
  local state
  for state in "${states[@]}"; do
    local issues count
    issues=$(pk_linear_issues_in_state "$state" 2>/dev/null || echo "[]")
    count=$(echo "$issues" | jq 'length')
    echo ""
    echo "$state ($count):"
    if [ "$count" = "0" ]; then
      echo "  (none)"
    else
      { echo "$issues" | jq -r '.[] | "  \(.identifier) — \(.title)"' | head -10; } || true
    fi
  done
  # Local in-flight
  echo ""
  echo "── Local worktrees ──"
  local prefix
  prefix=$(pk_worktree_prefix)
  git worktree list | grep -F "$prefix" || echo "  (none)"
}

cmd_branch() {
  local id=""
  local skip_install=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-install) skip_install=true; shift ;;
      --*) echo "Unknown flag: $1" >&2; return 1 ;;
      *)
        if [ -z "$id" ]; then
          id="$1"
        fi
        shift
        ;;
    esac
  done
  if [ -z "$id" ]; then
    echo "Usage: pk branch <ISSUE-ID> [--no-install]" >&2
    return 1
  fi
  local issue
  issue=$(pk_linear_issue "$id")
  if [ -z "$issue" ]; then
    echo "ERROR: issue $id not found in Linear" >&2
    return 1
  fi
  local title slug
  title=$(echo "$issue" | jq -r '.title')
  slug=$(pk_slug "$title")
  local branch_name="feature/${id}-${slug}"
  local root prefix wt_path
  root=$(pk_repo_root)
  prefix=$(pk_worktree_prefix)
  wt_path="${prefix}${id}-${slug}"

  # Idempotent: worktree already exists?
  if [ -d "$wt_path" ]; then
    echo "Worktree already exists: $wt_path"
  else
    local integration
    integration=$(pk_integration_branch)
    echo "Creating worktree at $wt_path off $integration..."
    git fetch origin "$integration" --quiet
    if git show-ref --verify --quiet "refs/heads/$branch_name"; then
      git worktree add "$wt_path" "$branch_name"
    else
      git worktree add "$wt_path" -b "$branch_name" "origin/$integration"
    fi
  fi

  # Symlink env files from the parent (root-level + nested per-app). Idempotent.
  pk_link_env_files "$root" "$wt_path"

  # Auto-allow direnv when .envrc was symlinked (v2.6.0.1). Direnv treats
  # the worktree path as a new .envrc and blocks it until allowed — but
  # the symlink target is the parent's .envrc which the user has already
  # `direnv allow`-ed (otherwise direnv wouldn't have loaded in the parent
  # to begin with). Without auto-allow, the symlink-fix from #14 is half-
  # broken: MCP servers and other direnv-loaded tooling still fail to auth
  # in the worktree at Claude Code launch. Fails soft when direnv isn't
  # installed.
  if [ -L "$wt_path/.envrc" ] && command -v direnv >/dev/null 2>&1; then
    direnv allow "$wt_path" >/dev/null 2>&1 || true
  fi

  # Sync parent's bin/pk into the worktree. Worktrees check out the committed
  # version of bin/pk (often older than the parent's working tree, especially
  # during alpha when patches land mid-flight). Without this, the worktree
  # runs an outdated pk while the parent has the fixes.
  if [ -f "$root/bin/pk" ] && [ "$root" != "$wt_path" ]; then
    cp "$root/bin/pk" "$wt_path/bin/pk" 2>/dev/null && chmod +x "$wt_path/bin/pk"
  fi

  # Linear status: → In Progress (idempotent)
  pk_linear_set_state "$id" "In Progress" || true

  echo ""
  echo "Done."

  # Fresh-worktree dependency install (F8 + v2.6.0 #15). Worktrees inherit
  # tracked files but not gitignored ones like node_modules/. Auto-running
  # the lockfile-matched install here prevents /work or test runs from
  # triggering a multi-minute install mid-flight. Pass --no-install to skip
  # when deps are already cached or you don't need them.
  local installed=false
  local pkg_install=""
  if [ -f "$wt_path/package.json" ] && [ ! -d "$wt_path/node_modules" ]; then
    if [ -f "$wt_path/pnpm-lock.yaml" ]; then
      pkg_install="pnpm install"
    elif [ -f "$wt_path/yarn.lock" ]; then
      pkg_install="yarn install"
    elif [ -f "$wt_path/package-lock.json" ]; then
      pkg_install="npm install"
    fi
    if [ -n "$pkg_install" ]; then
      if [ "$skip_install" = "true" ]; then
        echo ""
        echo "Skipping dep install (--no-install). Run before testing:"
        echo "  (cd $wt_path && $pkg_install)"
      else
        echo ""
        echo "Installing deps ($pkg_install)..."
        if (cd "$wt_path" && $pkg_install); then
          installed=true
        else
          echo ""
          echo "⚠️  install failed — fix and re-run:"
          echo "     (cd $wt_path && $pkg_install)"
        fi
      fi
    fi
  fi

  echo ""
  echo "To enter:"
  echo "  cd $wt_path && claude --dangerously-skip-permissions"
  if [ "$installed" = "true" ]; then
    echo ""
    echo "(next time use 'pk branch $id --no-install' to skip the dep install)"
  fi
}

cmd_ship() {
  local env=""
  local review=false
  # v2.6.0 #6: PRs open as Draft by default. Outside reviewers
  # (Semgrep, claude-review) trigger on `[opened, ready_for_review]` —
  # opening Draft means no reviews fire during iteration. Use
  # `pk ready <ID>` (or `pk ship --ready`) to flip Draft → Ready and
  # fire the merge-time review.
  local ready=false
  # v2.7: --force bypasses the verify-complete.md gate (wired Day 3).
  # Parsed now so callers can adopt the flag before the gate lands.
  local force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --env=*) env="${1#--env=}"; shift ;;
      --review) review=true; shift ;;
      --ready) ready=true; shift ;;
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  local current
  current=$(pk_current_branch)
  local issue
  issue=$(pk_branch_issue_id)
  if [ -z "$issue" ]; then
    echo "ERROR: not on a feature branch (no issue ID in branch name)" >&2
    return 1
  fi

  # --- v2.7 verify-complete.md gate (hard-fail) ---------------------------
  # Day 2 wired /verify to write Logs/Verify/<date>/<id>/verify-complete.md
  # on PASS. This block reads the sentinel; missing file means /verify was
  # not run or returned NEEDS WORK. Bypass via --force (Linear comment audit
  # trail) or PK_VERIFY_BYPASS=1 (emergency only, logs to bypass.log).
  if [ "${PK_VERIFY_BYPASS:-0}" = "1" ]; then
    echo "⚠ verify-complete.md gate bypassed via PK_VERIFY_BYPASS=1" >&2
    mkdir -p Logs/Verify 2>/dev/null
    echo "$(date -u +%FT%TZ) ${issue}" >> Logs/Verify/bypass.log 2>/dev/null || true
  else
    local _tier
    _tier=$(pk_linear_tier "$issue" 2>/dev/null || echo "standard")
    local _today _vc
    _today=$(date -u +%Y%m%d)
    _vc="Logs/Verify/${_today}/${issue}/verify-complete.md"

    if [ ! -f "$_vc" ]; then
      if [ "$_tier" = "quick" ]; then
        echo "⚠ verify-complete.md missing (${_vc}) — tier:quick is virtual, proceeding." >&2
      elif $force; then
        echo "⚠ verify-complete.md missing — bypassed via --force." >&2
        pk_linear_comment "$issue" "Shipped without verify-complete.md (--force at $(date -u +%FT%TZ))" || true
      else
        echo "ERROR: verify-complete.md missing for ${issue}." >&2
        echo "       Expected: ${_vc}" >&2
        echo "       Run /verify first, or pass --force to bypass (logs a Linear comment)." >&2
        return 1
      fi
    fi
  fi
  # ------------------------------------------------------------------------

  # Push (idempotent — git is fine with re-pushes)
  echo "Pushing $current..."
  git push -u origin "$current"

  # PR target
  local target
  if [ -n "$env" ]; then
    target="$env"
  else
    target=$(pk_integration_branch)
  fi

  # Idempotent: PR already exists?
  local pr_url
  pr_url=$(pk_gh_pr_view "$current" | jq -r '.url // empty')
  if [ -n "$pr_url" ]; then
    echo "PR already exists: $pr_url"
  else
    local title
    title=$(pk_linear_issue "$issue" | jq -r '.title // empty')
    local pr_body="Closes $issue"
    [ -n "$title" ] && pr_body="$pr_body — $title"
    pr_body="$pr_body

🤖 Generated with [Claude Code](https://claude.com/claude-code)"
    if $ready; then
      echo "Opening PR (Ready — --ready opt-out) against $target..."
      pr_url=$(pk_gh_pr_create --base "$target" --head "$current" \
        --title "${issue}: ${title:-$current}" \
        --body "$pr_body") || return 1
    else
      echo "Opening PR (Draft) against $target..."
      pr_url=$(pk_gh_pr_create --base "$target" --head "$current" \
        --title "${issue}: ${title:-$current}" \
        --body "$pr_body" --draft) || return 1
    fi
    echo "PR: $pr_url"
    if ! $ready; then
      echo ""
      echo "PR is Draft — outside reviewers (Semgrep, claude-review) will not fire yet."
      echo "When ready to merge: pk ready $issue"
    fi
  fi

  # Merge-strategy reminder. Squash is disabled repo-wide (v2.2.0+) — it
  # creates orphan SHAs that diverge dev and main, causing phantom conflicts
  # on every subsequent dev → main promote. See sop/Git_and_Deployment.md
  # § Merge Strategy by Hop.
  case "$target" in
    dev|beta)
      echo ""
      echo "⚑ Merge with: 'Rebase and merge' or 'Create a merge commit'."
      echo "  (Squash is disabled repo-wide — causes phantom conflicts on promotes.)"
      ;;
    main)
      echo ""
      echo "⚑ Merge with: 'Create a merge commit' (one anchor commit per promotion)."
      ;;
  esac

  # Linear: → In Review / UAT (state name varies; try common ones)
  local target_state
  case "$target" in
    main) target_state="UAT" ;;
    dev|beta) target_state="UAT" ;;
    *) target_state="In Review" ;;
  esac
  pk_linear_set_state "$issue" "$target_state" || pk_linear_set_state "$issue" "In Review" || true

  # Antagonistic review (opt-in via --review). Surfaces issues that /work
  # and /verify don't catch — security posture, test coverage gaps, double-
  # click races, etc. Posts findings as a PR review comment.
  if $review; then
    echo ""
    echo "Spawning antagonistic code review against $pr_url..."
    local pr_number
    pr_number=$(echo "$pr_url" | grep -oE '[0-9]+$')
    cat <<INSTRUCTIONS
Review the diff antagonistically. Find what could go wrong. Question every
shortcut. Cite file:line for each finding. Group by severity
(Critical/High/Medium/Low/Nit). Then post the review as a PR comment via:

  gh api -X POST repos/<owner>/<repo>/pulls/${pr_number}/reviews \\
    -f event=COMMENT -f body="<your full review markdown>"

PR: $pr_url
Issue: $issue ($target_state)
Branch: $current
INSTRUCTIONS
    echo ""
    echo "Run /pr-review-toolkit:review-pr or invoke pr-review-toolkit:code-reviewer"
    echo "agent with the above instructions. Once the review posts, the reviewer"
    echo "(or follow-up /pr-fix) should also post a Linear comment summarizing"
    echo "severity counts + verdict + PR URL — see pk_linear_comment helper."
    echo ""
    echo "(Automated subagent dispatch + auto Linear post is on the v2.1+"
    echo "backlog — see RUNBOOK § Backlog for /ship skill spec.)"

    # Best-effort: post a Linear comment now flagging that an antagonistic
    # review is in flight. Closes the visibility gap where Linear only sees
    # In Progress → UAT → Done with no record of the review having happened.
    pk_linear_comment "$issue" "**Antagonistic review requested** — \`pk ship --review\`

PR: $pr_url
Reviewer subagent invocation printed in pk output. Findings will land as a PR review comment; check the PR for results." || true
  fi
}

# v2.6.0 #6: flip a Draft PR to Ready. Fires the `ready_for_review` event,
# which is the trigger Pipekit's CI templates (templates/ci/semgrep.yml,
# templates/ci/claude-review.yml) listen for. Use this as the "I'm done
# iterating, run the outside reviewer now" gesture. No Linear state change
# (UAT stays UAT — the WIT was already In Review/UAT after pk ship).
cmd_ready() {
  local id="${1:-}"
  local current pr_number pr_state
  if [ -n "$id" ]; then
    # Explicit ID — find the feature branch locally so we can look up its PR.
    current=$(git branch --list "feature/${id}-*" --format="%(refname:short)" 2>/dev/null | head -1)
    if [ -z "$current" ]; then
      # No local branch — try matching by remote.
      current=$(git ls-remote --heads origin "feature/${id}-*" 2>/dev/null \
        | head -1 | awk '{print $2}' | sed 's|refs/heads/||')
    fi
    if [ -z "$current" ]; then
      echo "ERROR: no feature branch found matching feature/${id}-*" >&2
      return 1
    fi
  else
    current=$(pk_current_branch)
    id=$(pk_branch_issue_id)
    if [ -z "$id" ]; then
      echo "ERROR: pass <ISSUE-ID> or run from a feature branch (e.g. pk ready RS-60)" >&2
      return 1
    fi
  fi

  # Find the PR for this branch.
  local pr_view
  pr_view=$(pk_gh_pr_view "$current")
  pr_number=$(echo "$pr_view" | jq -r '.number // empty')
  pr_state=$(echo "$pr_view" | jq -r '.state // empty')
  if [ -z "$pr_number" ]; then
    echo "ERROR: no PR found for branch $current. Run 'pk ship' first." >&2
    return 1
  fi
  if [ "$pr_state" = "MERGED" ] || [ "$pr_state" = "CLOSED" ]; then
    echo "ERROR: PR #$pr_number for $current is $pr_state — nothing to flip." >&2
    return 1
  fi

  # Check current Draft state. `gh pr ready` is idempotent for Ready PRs
  # (no-op exit 0) but we want a clear message when there's nothing to do.
  local is_draft
  is_draft=$(gh pr view "$pr_number" --json isDraft -q '.isDraft' 2>/dev/null || echo "false")
  if [ "$is_draft" != "true" ]; then
    echo "PR #$pr_number is already Ready. No flip needed."
    return 0
  fi

  echo "Flipping PR #$pr_number Draft → Ready..."
  if ! gh pr ready "$pr_number" 2>&1; then
    echo "ERROR: gh pr ready failed. Check gh auth + PR permissions." >&2
    return 1
  fi
  echo "Done. Outside reviewers (Semgrep, claude-review) will now fire."
  echo "  PR: $(echo "$pr_view" | jq -r '.url // empty')"
}

cmd_done() {
  # --confirmed is accepted for backward compat (v2.4.3) but is now a no-op:
  # v2.5.0 dropped the UAT-state refusal because pk done IS the transition
  # out of UAT (UAT → In <FirstEnv> on merge). The pre-merge gate below is
  # what actually stops accidental early-fires.
  local do_merge=false id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --merge)     do_merge=true; shift ;;
      --confirmed) shift ;;
      --*)         echo "pk done: unknown arg $1" >&2; return 2 ;;
      *)           id="$1"; shift ;;
    esac
  done

  local current
  local issue
  if [ -n "$id" ]; then
    # Explicit ID — find the matching feature branch by glob.
    # This is the supported path: pk done is meant to run from the parent
    # repo (so it can delete the worktree), where the current branch is
    # 'dev' or 'main', not the feature branch being cleaned up.
    issue="$id"
    current=$(git branch --list "feature/${id}-*" --format="%(refname:short)" 2>/dev/null | head -1)
    if [ -z "$current" ]; then
      echo "ERROR: no local feature branch found matching feature/${id}-*" >&2
      return 1
    fi
  else
    # No arg — must be on the feature branch (rare; can only happen if
    # called from inside a worktree but worktree-removal will refuse).
    current=$(pk_current_branch)
    issue=$(pk_branch_issue_id)
    if [ -z "$issue" ]; then
      echo "ERROR: pass <ISSUE-ID> or run from a feature branch (e.g. pk done RS-60)" >&2
      return 1
    fi
  fi

  # Optional: merge the PR for the user (v2.5.0, M3 opt-in).
  # Merge-commit per repo policy (squash is disabled, --merge produces an
  # anchor commit on the integration branch). If the PR is already merged,
  # this is a clean no-op courtesy of gh's idempotent behavior.
  if $do_merge; then
    echo "Merging PR for $current..."
    if ! gh pr merge "$current" --merge 2>&1; then
      echo "ERROR: gh pr merge failed. Resolve (conflicts? failing CI? not approved?) and rerun." >&2
      return 1
    fi
  fi

  # Verify PR is merged. In the v2.5.0 model, pk done's primary job IS
  # confirming the merge happened — without it, the In <FirstEnv> state
  # transition would be a lie (code wouldn't actually be on the first env).
  local pr_state
  pr_state=$(pk_gh_pr_view "$current" | jq -r '.state // empty')
  if [ "$pr_state" != "MERGED" ]; then
    echo "ERROR: PR for $current is not merged (state: ${pr_state:-NOT_FOUND})" >&2
    echo "  Options:" >&2
    echo "    - Merge in GitHub UI, then rerun pk done." >&2
    echo "    - Or: pk done ${id:-} --merge  (lets pk run gh pr merge for you)." >&2
    return 1
  fi

  local root
  root=$(pk_repo_root)
  local wt_path
  wt_path=$(git worktree list --porcelain | awk -v branch="$current" '
    /^worktree / {wt=$2}
    $1=="branch" && $2=="refs/heads/"branch {print wt; exit}
  ')

  # Refuse early if CWD is inside the worktree we are about to remove.
  # Loop-notes #13: previously checked only `pwd == wt_path` (exact match);
  # a session inside a subdir (skills/, scripts/) would slip past, then
  # `git worktree remove --force` would destroy the session's CWD. We also
  # move this check above the Linear comment + diff calc so we don't post
  # "Shipped" notes for a run that's about to refuse.
  if [ -n "$wt_path" ] && [ "$root" != "$wt_path" ]; then
    local pwd_real wt_real
    pwd_real=$(cd "$(pwd)" 2>/dev/null && pwd -P) || pwd_real=$(pwd)
    wt_real=$(cd "$wt_path" 2>/dev/null && pwd -P) || wt_real="$wt_path"
    case "$pwd_real/" in
      "$wt_real"/*)
        echo "ERROR: pk done must run from the parent repo, not inside the worktree it removes." >&2
        echo "  worktree: $wt_path" >&2
        echo "  cwd:      $pwd_real" >&2
        echo "  Exit this session and rerun from the parent:" >&2
        echo "    exit && cd $root && claude" >&2
        echo "    pk done ${id:-$issue}" >&2
        return 1
        ;;
    esac
  fi

  # Build the Linear close comment from git directly (v2.1.2+).
  # Per-branch journals were retired — git log is the source of truth.
  local merge_base commits diffstat pr_url_done
  merge_base=$(git merge-base "$current" "$(pk_integration_branch)" 2>/dev/null || echo "")
  if [ -n "$merge_base" ]; then
    # Use awk instead of `head -20` — awk reads the full stream so git log
    # never gets SIGPIPE. Under `set -o pipefail`, head's early-exit kills
    # git log mid-stream and the pipeline returns 141, silently aborting
    # cmd_done with no output (RS-80 in rs-vault, 2026-05-05).
    commits=$(git log "${merge_base}..${current}" --pretty=format:'- %h %s' 2>/dev/null | awk 'NR<=20')
    diffstat=$(git diff --shortstat "${merge_base}..${current}" 2>/dev/null | sed 's/^[[:space:]]*//')
  fi
  pr_url_done=$(pk_gh_pr_view "$current" | jq -r '.url // empty')

  # Migration check — non-blocking. Runs if the merge contains .sql files in
  # the configured migration dir (method.config.md → "Migration dir").
  local migration_dir
  migration_dir=$(pk_config "Migration dir" "supabase/migrations/")
  if [ -n "$migration_dir" ] && [ -n "$merge_base" ]; then
    local new_migrations migration_count
    new_migrations=$(git diff --name-only "${merge_base}..${current}" 2>/dev/null \
      | grep "^${migration_dir}" | grep "\.sql$" || true)
    if [ -n "$new_migrations" ]; then
      migration_count=$(echo "$new_migrations" | wc -l | tr -d ' ')
      echo "→ ${migration_count} migration(s) in this merge — checking remote..."
      if command -v supabase &>/dev/null; then
        local remote_list
        remote_list=$(supabase migration list 2>/dev/null || true)
        local all_applied=true
        while IFS= read -r mfile; do
          local mname
          mname=$(basename "$mfile" .sql)
          if ! echo "$remote_list" | grep -qF "$mname"; then
            all_applied=false
            echo "  ⚠ not matched in 'supabase migration list': $mname"
          fi
        done <<< "$new_migrations"
        if [ "$all_applied" = true ]; then
          echo "  ✓ all ${migration_count} migration(s) applied to remote"
        else
          # Advisory only — this is a filename-basename heuristic, not proof of drift.
          # A legitimate collision-rename leaves the remote history holding the OLD
          # filename, so a real-and-applied migration shows as unmatched here.
          echo "  ℹ Filename heuristic — advisory, not a failure. If you recently"
          echo "    renamed a migration (collision fix), the remote may hold the old"
          echo "    name and this is a false alarm. Ground truth: 'supabase migration"
          echo "    list' or the live DB. If genuinely unapplied → run: supabase db push"
        fi
      else
        echo "  ⚠ supabase CLI not found — verify migrations manually: supabase migration list"
      fi
    fi
  fi

  local body="**Shipped — ${issue}**"
  [ -n "$pr_url_done" ] && body="$body
PR: $pr_url_done"
  [ -n "$diffstat" ]    && body="$body
Diff: $diffstat"
  if [ -n "$commits" ]; then
    body="$body

**Commits:**
$commits"
  fi
  pk_linear_comment "$issue" "$body" || true

  # Linear state transition (v2.5.0): UAT → In <FirstEnv>, or → Done for
  # 1-tier projects where the merge IS the final deploy. This reverses the
  # v2.3.0 "cleanup-only" rule, which assumed UAT covered every post-ship
  # phase. The v2.5.0 model splits that: UAT = "PR open on preview", and
  # In <FirstEnv> = "merged, code on dev". pk done is the legitimate
  # transition point because it has just verified the merge happened.
  local next_state
  next_state=$(pk_first_env_state_name)
  if [ -n "$next_state" ]; then
    if ! pk_linear_set_state "$issue" "$next_state" "advance"; then
      echo "⚠️  Linear: $issue — transition to '$next_state' FAILED. The merge succeeded and" >&2
      echo "    cleanup will continue, but the issue is stranded in its current state — this is" >&2
      echo "    the recurring Linear-state-lag class. Reconcile via the Linear UI or rerun pk done." >&2
    fi
  fi

  echo "Removing worktree..."
  if [ -n "$wt_path" ] && [ -d "$wt_path" ]; then
    git worktree remove "$wt_path" --force 2>/dev/null || rm -rf "$wt_path"
  fi

  # If the parent repo is sitting on the just-merged feature branch, return it to
  # the integration branch before deleting it. You can't delete the branch you're
  # on (the delete below would silently no-op), and leaving the parent parked on a
  # merged branch is the recurring "needs git checkout dev" friction. Guard on a
  # clean tree — never discard uncommitted work.
  local integration_branch on_branch
  integration_branch=$(pk_integration_branch)
  on_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
  if [ -n "$integration_branch" ] && [ "$on_branch" = "$current" ]; then
    if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
      if git checkout "$integration_branch" --quiet 2>/dev/null; then
        echo "Returned parent repo to $integration_branch (was on merged branch $current)."
      fi
    else
      echo "⚠️  Parent repo is on merged branch $current with uncommitted changes — not switching."
      echo "    When ready: git stash && git checkout $integration_branch"
    fi
  fi

  echo "Deleting local branch $current..."
  git branch -D "$current" 2>/dev/null || true

  # Auto-pull integration branch (v2.6.0 #8). After a confirmed merge, the
  # parent's local integration branch is stale. Fast-forward it if we're
  # on it; otherwise fetch so the next checkout is current. Divergence is
  # rare but real (concurrent push to dev) — warn rather than fail because
  # the merge already succeeded and the user can reconcile manually.
  local integration head_branch
  integration=$(pk_integration_branch)
  if [ -n "$integration" ]; then
    head_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    if [ "$head_branch" = "$integration" ]; then
      if ! git pull --ff-only origin "$integration" --quiet 2>/dev/null; then
        echo "⚠️  Local $integration diverges from origin/$integration — reconcile manually."
      fi
    else
      git fetch origin "$integration" --quiet 2>/dev/null || true
    fi
  fi

  # Write VBW SUMMARY + flip PLAN status (v2.6.0 #2). Best-effort: skips
  # silently when there's no .vbw-planning/ or no matching PLAN.md.
  # Unblocks fresh-worktree edits for batch flows — VBW's file-guard
  # otherwise treats `status: ready` PLAN.md files as still-active and
  # blocks edits outside their files_modified list.
  local merge_sha commits_count
  merge_sha=$(git rev-parse --short "origin/${integration}" 2>/dev/null || echo "")
  commits_count="0"
  [ -n "${commits:-}" ] && commits_count=$(echo "$commits" | wc -l | tr -d ' ')
  local plan_touched
  plan_touched=$(pk_vbw_finalize_plan "$root" "$issue" "${pr_url_done:-}" "$merge_sha" "$commits_count" "${diffstat:-}" 2>/dev/null || true)
  if [ -n "$plan_touched" ]; then
    echo ""
    echo "VBW: marked plan complete + wrote summary"
    echo "$plan_touched" | sed 's/^/  → /'
    echo "  Commit when ready: git add .vbw-planning/ && git commit"
  fi

  # Deploy reminder (non-branch-per-env projects). When a project deploys via a
  # script rather than branch promotion, `pk promote` is disabled and nothing in
  # the loop ensures the merged code reached an environment ("merged ≠ deployed").
  # If method.config.md sets a Deploy command, surface it so Done can't be silently
  # reached without a deploy. Advisory — never auto-run a deploy (outward-facing).
  local deploy_cmd
  deploy_cmd=$(pk_config "Deploy command" "")
  if [ -n "$deploy_cmd" ]; then
    echo ""
    echo "🚀 Deploy step — this project deploys by script, not branch promotion."
    echo "   Merged ≠ deployed. Run when ready:  $deploy_cmd"
  fi

  # Advisory: a local Supabase stack / dev server started inside the worktree
  # keeps running after teardown. pk done does NOT stop it — a local stack may be
  # shared across worktrees, so killing it blindly is unsafe. Just remind.
  if command -v supabase >/dev/null 2>&1 && [ -d "$root/supabase" ]; then
    echo ""
    echo "ℹ If you started a local Supabase stack / dev server in the worktree, it's still running."
    echo "  pk done won't stop it (may be shared). If idle:  supabase stop  (and kill any dev server)."
  fi

  echo "Done."
}

cmd_verify() {
  local cmd
  cmd=$(awk '
    /^## Pre-Deploy Gate[[:space:]]*$/ { in_section=1; next }
    in_section && /^## / { exit }
    in_section && /^```/ {
      if (in_fence) exit
      in_fence=1
      next
    }
    in_section && in_fence { print }
  ' "$(pk_config_path)" 2>/dev/null || true)
  if [ -z "$cmd" ]; then
    echo "No Pre-Deploy Gate configured in method.config.md."
    return 1
  fi
  echo "Running pre-deploy gate..."
  echo "$cmd" | bash || return $?

  # Optional: self-reference check (catches RS-29-style integration misses
  # where the gate is green but a predecessor's placeholder still references
  # the current ticket in an un-touched file). Opt-in via:
  #   | **Self-reference check** | `enabled` |
  # in method.config.md. The script lives in pipekit and gets synced.
  local sr_flag root sr_script
  sr_flag=$(pk_config "Self-reference check" "disabled")
  if [ "$sr_flag" = "enabled" ]; then
    root=$(pk_repo_root)
    sr_script="$root/scripts/check-no-self-references.sh"
    if [ -x "$sr_script" ]; then
      echo ""
      bash "$sr_script" || return $?
    else
      echo "  ⓘ Self-reference check enabled but script not found at $sr_script" >&2
      echo "    Run scripts/sync-method.sh from pipekit to install it." >&2
    fi
  fi
}

# Walks `Ship environments` one hop per invocation. Target arg is the
# destination env. Two-phase Linear state transition (v2.6.0 #3 / F2):
#   - `pk promote <env>` opens the PR, WITs stay in source state.
#   - `pk promote <env> --finish` transitions WITs to target state after merge.
# Replaces the v2.3.0–v2.5.0 optimistic-at-PR-open behavior, which left
# Linear ~5 minutes ahead of reality while the promote PR was open.
# Position-based state mapping: last hop → Done, any non-last → In <Env>.
cmd_promote() {
  local stash=false take_remote=false bootstrap=false confirmed=false finish=false target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --stash)       stash=true;       shift ;;
      --take-remote) take_remote=true; shift ;;
      --bootstrap)   bootstrap=true;   shift ;;
      --confirmed)   confirmed=true;   shift ;;
      --finish)      finish=true;      shift ;;
      --*)           echo "pk promote: unknown arg $1" >&2; return 2 ;;
      *)             target="$1";      shift ;;
    esac
  done
  if $stash && $take_remote; then
    echo "ERROR: --stash and --take-remote are mutually exclusive." >&2
    return 2
  fi

  local promote
  promote=$(pk_config "Promote to main" "true")
  if [ "$promote" != "true" ]; then
    echo "Promote to main is disabled in method.config.md (single-tier project)."
    return 0
  fi

  # Resolve Ship environments chain. Trim whitespace per element.
  local ship_envs envs_arr=()
  ship_envs=$(pk_config "Ship environments" "dev,main")
  IFS=',' read -ra envs_arr <<< "$ship_envs"
  local i
  for i in "${!envs_arr[@]}"; do
    envs_arr[$i]=$(echo "${envs_arr[$i]}" | tr -d ' ')
  done
  if [ ${#envs_arr[@]} -lt 2 ]; then
    echo "ERROR: 'Ship environments' must list at least two envs (e.g. dev,main)." >&2
    return 2
  fi

  # Resolve target. With no arg + 2-tier chain → auto-pick the only hop.
  # Otherwise require an explicit target to avoid accidental skip-ahead.
  if [ -z "$target" ]; then
    if [ ${#envs_arr[@]} -eq 2 ]; then
      target="${envs_arr[1]}"
    else
      echo "ERROR: Ship environments has multiple hops. Specify target:" >&2
      echo "  pk promote <env>   (valid: ${envs_arr[*]:1})" >&2
      return 2
    fi
  fi

  local target_idx=-1
  for i in "${!envs_arr[@]}"; do
    [ "${envs_arr[$i]}" = "$target" ] && target_idx=$i && break
  done
  if [ "$target_idx" -lt 1 ]; then
    echo "ERROR: '$target' is not a valid promote target in Ship environments." >&2
    echo "  Valid targets: ${envs_arr[*]:1}" >&2
    return 2
  fi

  local source="${envs_arr[$((target_idx - 1))]}"

  # Resolve target state name early — both phases need it.
  local target_state
  target_state=$(pk_env_state_name "$target")
  if [ -z "$target_state" ]; then
    echo "ERROR: could not derive state name for env '$target' (not in Ship environments?)" >&2
    return 1
  fi

  # ─── Phase 2: --finish — transition Linear states after merge ───
  # Looks up the most recent merged promote PR between source and target,
  # parses its body for the pipekit-promote-tracking marker (containing
  # bundled WITs), and transitions each WIT to the target state. Falls
  # back to deriving from PR commits if no marker is found (older PRs).
  if $finish; then
    echo "pk promote --finish: $source → $target"

    # Find most recent merged promote PR.
    local merged_pr_json pr_number pr_url pr_body pr_merged_at
    merged_pr_json=$(gh pr list --base "$target" --head "$source" --state merged \
      --limit 1 --json number,url,body,mergedAt 2>/dev/null || echo "[]")
    pr_number=$(echo "$merged_pr_json" | jq -r '.[0].number // empty')
    if [ -z "$pr_number" ]; then
      echo "ERROR: no merged promote PR found for $source → $target." >&2
      echo "  Open one first: pk promote $target" >&2
      return 1
    fi
    pr_url=$(echo "$merged_pr_json" | jq -r '.[0].url // empty')
    pr_body=$(echo "$merged_pr_json" | jq -r '.[0].body // empty')
    pr_merged_at=$(echo "$merged_pr_json" | jq -r '.[0].mergedAt // empty')
    echo "  PR #$pr_number (merged $pr_merged_at): $pr_url"

    # Parse the tracking marker. Marker format:
    # <!-- pipekit-promote-tracking: source=<s> target=<t> wits=<W1,W2,...> -->
    local wits_csv issue_ids
    wits_csv=$(echo "$pr_body" | grep -oE 'pipekit-promote-tracking:[^>]*wits=[A-Za-z0-9,-]*' \
      | sed -E 's/.*wits=//' | head -1)
    if [ -n "$wits_csv" ]; then
      issue_ids=$(echo "$wits_csv" | tr ',' '\n' | grep -E '.+' || true)
    else
      # Fallback: derive from PR commits (for promote PRs opened pre-v2.6.0
      # without the marker).
      local issue_prefix
      issue_prefix=$(pk_config "Issue prefix" "")
      if [ -n "$issue_prefix" ]; then
        issue_ids=$(gh pr view "$pr_number" --json commits 2>/dev/null \
          | jq -r '.commits[].messageBody, .commits[].messageHeadline' 2>/dev/null \
          | { grep -oE "${issue_prefix}-[0-9]+" || true; } | sort -u)
      fi
      if [ -n "$issue_ids" ]; then
        echo "  (no marker; derived WITs from PR commits)"
      fi
    fi

    if [ -z "$issue_ids" ]; then
      echo "  No bundled WITs found in PR #$pr_number — nothing to transition."
      return 0
    fi

    local id_count
    id_count=$(echo "$issue_ids" | wc -l | tr -d ' ')
    echo "  Transitioning $id_count issue(s) → $target_state"
    local fail_count=0
    while IFS= read -r issue_id; do
      [ -z "$issue_id" ] && continue
      if ! pk_linear_set_state "$issue_id" "$target_state" "advance"; then
        fail_count=$((fail_count + 1))
        if [ "$target_state" = "Done" ]; then
          echo "    Linear: $issue_id — transition to Done failed. Check state name + permissions." >&2
        else
          echo "    Linear: $issue_id — state '$target_state' not configured in Linear. Add it (type: started) via Linear UI, then re-run." >&2
        fi
      fi
    done <<< "$issue_ids"
    if [ "$fail_count" -gt 0 ]; then
      echo ""
      echo "$fail_count transition(s) failed. Fix the cause and rerun: pk promote $target --finish"
      return 1
    fi
    echo "Done."
    return 0
  fi
  # ─── End Phase 2 ───

  # Guard against missing target branch on origin. GitHub's repo-level
  # "auto-delete head branches" will silently remove long-lived release
  # branches (e.g. beta) when a beta→main PR merges, and the previous
  # behavior was for the downstream `git log origin/$target..origin/$source`
  # to exit 128 with --quiet swallowing the diagnostic. Refuse loudly here.
  if ! git ls-remote --exit-code origin "refs/heads/$target" >/dev/null 2>&1; then
    if $bootstrap; then
      echo "  → --bootstrap: creating origin/$target at origin/$source tip"
      git fetch origin "$source" --quiet
      local origin_url owner_repo source_sha
      origin_url=$(git remote get-url origin)
      owner_repo=$(echo "$origin_url" | sed -E 's#\.git$##' | sed -E 's#^.*github\.com[:/]##')
      source_sha=$(git rev-parse "origin/$source")
      if ! gh api -X POST "repos/$owner_repo/git/refs" \
        -f ref="refs/heads/$target" -f sha="$source_sha" >/dev/null; then
        echo "ERROR: --bootstrap failed to create origin/$target via gh api." >&2
        echo "  Verify gh auth (gh auth status) and write permission on $owner_repo." >&2
        return 1
      fi
      echo "  → origin/$target created at $source_sha"
    else
      local origin_url owner_repo
      origin_url=$(git remote get-url origin 2>/dev/null || echo "")
      owner_repo=$(echo "$origin_url" | sed -E 's#\.git$##' | sed -E 's#^.*github\.com[:/]##')
      echo "ERROR: origin/$target does not exist." >&2
      echo "" >&2
      echo "  The remote branch '$target' is missing. This usually means GitHub's" >&2
      echo "  'auto-delete head branches' setting removed it after a previous" >&2
      echo "  promote PR merged. Recreate it from origin/$source:" >&2
      echo "" >&2
      if [ -n "$owner_repo" ]; then
        echo "    gh api -X POST repos/$owner_repo/git/refs \\" >&2
        echo "      -f ref=refs/heads/$target \\" >&2
        echo "      -f sha=\$(git rev-parse origin/$source)" >&2
      else
        echo "    gh api -X POST repos/<owner>/<repo>/git/refs \\" >&2
        echo "      -f ref=refs/heads/$target \\" >&2
        echo "      -f sha=\$(git rev-parse origin/$source)" >&2
      fi
      echo "" >&2
      echo "  Or rerun with --bootstrap to auto-create it:" >&2
      echo "    pk promote $target --bootstrap" >&2
      echo "" >&2
      echo "  Long-term fix: protect '$target' against deletion (see Pipekit handoff #26)." >&2
      return 1
    fi
  fi

  echo "Promote $source → $target"
  echo "  1. Sync $source"
  git checkout "$source"

  # Conflict-pattern guard: local edits to tracked files can block the
  # ff-only pull when incoming commits touch the same paths.
  local dirty stash_made=false
  dirty=$(git status --porcelain | grep -E '^( M|M | A|A )' || true)
  if [ -n "$dirty" ]; then
    if $take_remote; then
      echo "  → --take-remote: discarding local edits to tracked files:"
      echo "$dirty" | sed 's/^/      /'
      git fetch origin "$source" --quiet
      while IFS= read -r line; do
        local path
        path=$(echo "$line" | awk '{print $2}')
        [ -n "$path" ] && git checkout "origin/$source" -- "$path"
      done <<< "$dirty"
    elif $stash; then
      echo "  → --stash: stashing local edits before pull"
      git stash push -m "pk promote auto-stash $(date +%s)" -- $(echo "$dirty" | awk '{print $2}') >/dev/null
      stash_made=true
    else
      echo ""
      echo "ERROR: local modifications to tracked files may block the fast-forward:" >&2
      echo "$dirty" | sed 's/^/    /' >&2
      echo "" >&2
      echo "Options:" >&2
      echo "  pk promote $target --stash         stash before pull, pop after PR opens" >&2
      echo "  pk promote $target --take-remote   discard local edits in favor of incoming $source" >&2
      echo "  (or) commit / stash / discard manually, then rerun pk promote" >&2
      return 1
    fi
  fi

  if ! git pull --ff-only; then
    echo "ERROR: ff-only pull failed unexpectedly. Resolve manually and rerun pk promote." >&2
    $stash_made && echo "  Note: your edits are stashed (git stash list)." >&2
    return 1
  fi

  echo "  2. Run pre-deploy gate"
  if ! cmd_verify; then
    $stash_made && echo "  Note: your edits are stashed (git stash list — run 'git stash pop' to restore)." >&2
    return 1
  fi

  git fetch origin "$target" --quiet 2>/dev/null || true
  local commits_ahead
  commits_ahead=$(git log "origin/$target..origin/$source" --oneline 2>/dev/null | wc -l | tr -d ' ')
  if [ "$commits_ahead" = "0" ]; then
    echo "  Nothing to promote — $source is not ahead of $target."
    return 0
  fi

  # UAT-state code refusal (v2.4.3) — belt-and-braces for v2.4.2's doc gate.
  # Bundled issues still in 'UAT' mean the user hasn't signed off yet;
  # opening the promote PR jumps that gate. Only refuses on UAT — Released
  # / Done are fine (re-promote bundles), and Approved-or-earlier is already
  # caught by the v2.3.3 ladder leap-frog refusal in pk_linear_set_state
  # (so we don't double-emit here). --confirmed bypasses.
  local issue_prefix
  issue_prefix=$(pk_config "Issue prefix" "")
  if ! $confirmed && [ -n "$issue_prefix" ]; then
    local bundled_ids
    # `{ grep ... || true; }` because under `set -euo pipefail`, grep with
    # no matches exits 1 and pipefail propagates that, killing the script
    # before the `if [ -n "$bundled_ids" ]` check below can skip cleanly.
    # Scoped to grep so a later sort failure still surfaces.
    bundled_ids=$(git log "origin/$target..origin/$source" --pretty=format:%s%n%b 2>/dev/null \
      | { grep -oE "${issue_prefix}-[0-9]+" || true; } | sort -u)
    if [ -n "$bundled_ids" ]; then
      local uat_ids=""
      while IFS= read -r bid; do
        [ -z "$bid" ] && continue
        local bstate
        bstate=$(pk_linear_get_state "$bid" 2>/dev/null || echo "")
        if [ "$bstate" = "UAT" ]; then
          uat_ids="${uat_ids:+$uat_ids }$bid"
        fi
      done <<< "$bundled_ids"
      if [ -n "$uat_ids" ]; then
        echo "ERROR: bundled issue(s) still in 'UAT': $uat_ids" >&2
        echo "  Complete interactive UAT and merge the feature PR(s) first." >&2
        echo "  Re-run with --confirmed once UAT is signed off:" >&2
        echo "    pk promote $target --confirmed" >&2
        $stash_made && echo "  Note: your edits are stashed (git stash list)." >&2
        return 1
      fi
    fi
  fi

  echo "  3. Open promote PR ($source → $target, $commits_ahead commits)"

  # Compute bundled WITs and embed them in the PR body as a tracking marker.
  # v2.6.0 #3 / F2: Phase 2 (--finish) reads this marker to know which WITs
  # to transition post-merge. Marker format is intentionally stateless and
  # cross-machine-portable (lives on the PR, not in local files).
  local bundled_wits_csv=""
  if [ -n "$issue_prefix" ]; then
    bundled_wits_csv=$(git log "origin/$target..origin/$source" --pretty=format:%s%n%b 2>/dev/null \
      | { grep -oE "${issue_prefix}-[0-9]+" || true; } | sort -u \
      | tr '\n' ',' | sed 's/,$//')
  fi

  local date promote_url pr_body
  date=$(date +%Y-%m-%d)
  pr_body="Batch promote. Merge-commit per ruleset (one anchor commit on $target per promote).

<!-- pipekit-promote-tracking: source=$source target=$target wits=$bundled_wits_csv -->

After merging in the GitHub UI, run: \`pk promote $target --finish\`
to transition bundled WITs to \`$target_state\` in Linear."

  promote_url=$(pk_gh_pr_create --base "$target" --head "$source" \
    --title "Promote $source → $target ($date)" \
    --body "$pr_body") || return 1
  echo "PR: $promote_url"

  # v2.6.0 #3 / F2 — Linear state transitions moved to Phase 2 (--finish).
  # Bundled WITs stay in the source-env state while the promote PR is open.
  # Eliminates the ~5min window where Linear was ahead of reality.

  if $stash_made; then
    echo ""
    echo "Note: your local edits are stashed. Run 'git stash pop' after the promote PR is merged."
  fi
  echo ""
  echo "Bundled WITs stay in source state until merge."
  if [ -n "$bundled_wits_csv" ]; then
    local bundled_count
    bundled_count=$(echo "$bundled_wits_csv" | tr ',' '\n' | grep -cE '.+')
    echo "  ($bundled_count WIT(s) tracked: $bundled_wits_csv)"
  fi
  echo ""
  echo "After merging in the GitHub UI:"
  echo "  pk promote $target --finish"
}

cmd_log() {
  # v2.1.2+: session logs are date-stamped narrative files written by /pk-exit.
  # Per-branch journals were retired — they were a stale cache of git log.
  local root
  root=$(pk_repo_root) || { echo "ERROR: not in a git repo" >&2; return 1; }
  local logs_dir="$root/Logs/Sessions"
  if [ ! -d "$logs_dir" ]; then
    echo "No session logs yet."
    echo "  Expected at: $logs_dir"
    echo "  Run /pk-exit at the end of each Claude session to write one."
    return 0
  fi
  local latest
  latest=$(ls -1 "$logs_dir" 2>/dev/null | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}.*\.md$' | sort | tail -1)
  if [ -z "$latest" ]; then
    echo "No session logs in $logs_dir."
    echo "  Run /pk-exit at the end of each Claude session to write one."
    return 0
  fi
  echo "── Latest session log: $latest ──"
  echo ""
  cat "$logs_dir/$latest"
}

cmd_init_bootstrap() {
  # Scaffold or update method.config.md via the pk-init pipeline:
  # detect → prompt → render → review → confirm → write.
  local root="$1"
  shift
  local main_sh
  main_sh="$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/pk-init/main.sh"
  if [ ! -x "$main_sh" ]; then
    echo "ERROR: pk-init/main.sh not found at $main_sh" >&2
    return 1
  fi
  exec "$main_sh" "$root" "$@"
}

cmd_init() {
  local root
  root=$(pk_repo_root) || { echo "ERROR: not in a git repo" >&2; return 1; }
  local cfg="$root/method.config.md"

  # --update: re-run detection against existing config.
  for arg in "$@"; do
    if [ "$arg" = "--update" ]; then
      if [ ! -f "$cfg" ]; then
        echo "ERROR: --update requires existing method.config.md (none found)." >&2
        echo "       Run 'pk init' (no flag) to bootstrap first." >&2
        return 1
      fi
      cmd_init_bootstrap "$root" --update
      return $?
    fi
  done

  if [ ! -f "$cfg" ]; then
    cmd_init_bootstrap "$root"
    return $?
  fi
  echo "── pk init ──"
  echo ""
  echo "Checking your method.config.md for v2 keys..."
  echo ""
  local needed=("Backend" "Integration branch" "Promote to main" "Require QA review")
  local missing=()
  for k in "${needed[@]}"; do
    local v
    v=$(pk_config "$k" "")
    if [ -z "$v" ]; then
      missing+=("$k")
    else
      echo "  ✓ $k: $v"
    fi
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo ""
    echo "Missing v2 keys (using defaults):"
    for k in "${missing[@]}"; do echo "  ⚠ $k"; done
    echo ""
    echo "Add the V2 section from method/templates/v2/ or method.config.template.md to set explicitly."
  fi
  # Session logs (v2.1.2+: replaced the bash Stop hook + per-branch journal).
  echo ""
  echo "Session logs:"
  local logs_dir="$root/Logs/Sessions"
  if [ -d "$logs_dir" ]; then
    local count
    count=$(ls -1 "$logs_dir" 2>/dev/null | grep -cE '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}.*\.md$' || echo 0)
    echo "  ✓ $logs_dir ($count log(s))"
  else
    mkdir -p "$logs_dir" 2>/dev/null && echo "  ✓ created $logs_dir" || echo "  ⚠ $logs_dir missing (couldn't create)"
  fi
  echo "  Run /pk-exit at the end of every Claude session to write a session log."
  # Flag a stale Stop hook if one is wired (v2.0/v2.1 leftover).
  if [ -f "$root/.claude/settings.json" ] && grep -q "pipekit-journal-hook" "$root/.claude/settings.json" 2>/dev/null; then
    echo "  ⚠ stale 'pipekit-journal-hook' Stop hook in .claude/settings.json — retired in v2.1.2"
    echo "      Remove the Stop block from .claude/settings.json; /pk-exit replaces it."
  fi
  if [ -f "$root/scripts/pipekit-journal-hook.sh" ]; then
    echo "  ⚠ stale scripts/pipekit-journal-hook.sh — retired in v2.1.2; safe to delete"
  fi
  if [ -d "$root/.pipekit/journal" ]; then
    echo "  ⚠ stale .pipekit/journal/ directory — retired in v2.1.2; safe to delete"
  fi
  # Linear API key
  echo ""
  local key_var key
  key_var=$(pk_linear_api_key_var)
  key=$(pk_linear_api_key)
  if [ -n "$key" ]; then
    echo "  ✓ \$$key_var is set"
  else
    echo "  ✗ \$$key_var not exported. Set in shell rc:"
    echo "    export $key_var=lin_api_xxx"
  fi
  # Notepad convention (v2.1.1+) — seed a gitignored personal notepad if
  # one doesn't already exist. Replaces v1's NEXT.md (which was machine-
  # readable state — pk next is now canonical for "what to do next").
  echo ""
  echo "Notepad:"
  local notepad="$root/notepad.md"
  local gi="$root/.gitignore"
  if [ ! -f "$notepad" ]; then
    cat > "$notepad" <<NOTEPAD
# Notepad

Personal scratch — gitignored, never committed. Use freely.

For "what should I do next?" run \`pk next\` (phase-aware as of pipekit v2.1.0).
NOTEPAD
    echo "  ✓ created notepad.md (gitignored, personal scratch)"
  else
    echo "  ✓ notepad.md already exists (kept as-is)"
  fi
  if [ -f "$gi" ] && ! grep -qE '^notepad\.md$' "$gi"; then
    echo "" >> "$gi"
    echo "# personal notepad — replaces v1 NEXT.md; free-form, never committed" >> "$gi"
    echo "notepad.md" >> "$gi"
    echo "  ✓ added 'notepad.md' to .gitignore"
  elif [ -f "$gi" ]; then
    echo "  ✓ .gitignore already excludes notepad.md"
  fi
  # If a stale NEXT.md is hanging around, flag it (don't auto-delete — user's call)
  if [ -f "$root/NEXT.md" ]; then
    echo "  ⚠ NEXT.md present — v1 artifact, retired in v2. Consider removing:"
    echo "      git rm NEXT.md  &&  git commit -m 'chore: retire NEXT.md (use pk next)'"
  fi

  echo ""
  echo "Next: pk doctor (deeper check) → pk next (find an issue) → pk branch <ID>"
}

cmd_delegate() {
  local id="${1:-}"
  shift || true
  local prompt="$*"
  if [ -z "$id" ] || [ -z "$prompt" ]; then
    echo "Usage: pk delegate <ISSUE-ID> <prompt-for-Linear-Agent>" >&2
    echo "  Posts an @Linear-mentioned comment to invoke the Linear Agent." >&2
    return 1
  fi
  local body="@Linear $prompt"
  pk_linear_comment "$id" "$body"
}

# ─────────────────────────────────────────────────────────────────────────────
# spec-cycle: trigger Linear Spec Review Agent v5, poll for verdict, dispatch
# ─────────────────────────────────────────────────────────────────────────────
#
# Exit codes:
#   0 — verdict parsed (Pass: state transitioned to "Approved" and printed
#                       Revise: instruction printed for caller to invoke /02)
#   1 — preflight failure (wrong state, stalemate cap hit, timeout, malformed)
#   2 — infrastructure failure (Linear API error)
#
# stdout (machine-readable last line — callers may parse):
#   VERDICT: Pass
#   VERDICT: Revise
#   VERDICT: Stalemate
#   VERDICT: Timeout
#   VERDICT: Malformed

PK_LINEAR_AGENT_DISPLAY_NAME="linear"

pk_linear_comments() {
  local id="$1"
  local q='query($id: String!) { issue(id: $id) { comments(orderBy: createdAt) { nodes { id body createdAt user { displayName } } } } }'
  pk_linear_gql "$q" "$(jq -n --arg id "$id" '{id:$id}')" \
    | jq -r '.data.issue.comments.nodes // []'
}

pk_spec_cycle_agent_count() {
  local id="$1"
  pk_linear_comments "$id" \
    | jq --arg name "$PK_LINEAR_AGENT_DISPLAY_NAME" \
        '[.[] | select(.user.displayName == $name)] | length'
}

pk_spec_cycle_latest_agent_body_since() {
  local id="$1" since="$2"
  pk_linear_comments "$id" \
    | jq -r --arg name "$PK_LINEAR_AGENT_DISPLAY_NAME" --arg since "$since" '
        [.[] | select(.user.displayName == $name and .createdAt > $since)]
        | sort_by(.createdAt) | last // empty | .body // empty
      '
}

pk_spec_cycle_trigger_body() {
  cat <<'EOF'
@linear review this spec using Spec Review Agent (v5).

Assess whether it is safe and ready for VBW planning. Focus on planning readiness, scope clarity, authority/source of truth, edge cases, financial correctness if relevant, and decomposition readiness.

**REQUIRED: Your response must begin with exactly one of these two lines — nothing before it, no extra words:**
Verdict: Pass
Verdict: Revise

Then continue with:
Recommended Flag: Blocked, Quick Win, Spec: Needed, Spec: Pass, or Spec: Revise
Readiness Score: <N>/10
Blocking Issues: <list or "None">
Non-Blocking Improvements: <list or "None">
Fast Path to Pass: <1-2 sentences or "N/A">
Decomposition Readiness: Yes or No
Final Recommendation: <1-2 sentences>

Then update the issue description by replacing the existing ## Agent Review section with the new review.
EOF
}

cmd_spec_cycle() {
  local id="${1:-}"
  if [ -z "$id" ]; then
    echo "Usage: pk spec-cycle <ISSUE-ID>" >&2
    echo "  Trigger Spec Review Agent v5, poll for verdict, dispatch." >&2
    return 1
  fi

  local ready_state approved_state
  ready_state=$(pk_config "Spec ready state" "Specced")
  approved_state=$(pk_config "Spec approved state" "Approved")

  # 1. Validate state.
  local state_q='query($id: String!) { issue(id: $id) { id state { name } } }'
  local resp current_state
  resp=$(pk_linear_gql "$state_q" "$(jq -n --arg id "$id" '{id:$id}')") || return 2
  current_state=$(echo "$resp" | jq -r '.data.issue.state.name // empty')
  if [ -z "$current_state" ]; then
    echo "ERROR: issue $id not found" >&2
    return 1
  fi
  if [ "$current_state" != "$ready_state" ]; then
    echo "ERROR: $id is in '$current_state', not '$ready_state'." >&2
    echo "  Run /01-light-spec $id first to publish a spec." >&2
    return 1
  fi

  # 2. Stalemate guard.
  local prior_count
  prior_count=$(pk_spec_cycle_agent_count "$id")
  if [ "$prior_count" -ge 3 ]; then
    echo "STALEMATE: $id has $prior_count prior agent reviews." >&2
    echo "  Run /02-light-spec-revise $id and use the override path." >&2
    echo "VERDICT: Stalemate"
    return 1
  fi

  # 3. Capture cutoff timestamp and post trigger.
  local since
  since=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")
  echo "→ posting Spec Review Agent v5 trigger on $id (review #$((prior_count + 1)) of 3)"
  pk_linear_comment "$id" "$(pk_spec_cycle_trigger_body)" || return 2

  # 4. Poll: 30s × 10 = 5 min cap.
  local attempts=10 sleep_s=30 i=0 body=""
  echo "→ polling for verdict (cap 5 min, every ${sleep_s}s)"
  while [ $i -lt $attempts ]; do
    sleep $sleep_s
    body=$(pk_spec_cycle_latest_agent_body_since "$id" "$since")
    if [ -n "$body" ]; then break; fi
    i=$((i + 1))
    printf "."
  done
  echo
  if [ -z "$body" ]; then
    echo "TIMEOUT: no agent response after 5 min. Check Linear UI." >&2
    echo "VERDICT: Timeout"
    return 1
  fi

  # 5. Parse Verdict line.
  local verdict
  verdict=$(echo "$body" | grep -iE '^Verdict:' | head -1 \
    | sed -E 's/^Verdict:[[:space:]]*//I; s/[[:space:]]+$//')
  case "$verdict" in
    Pass|pass|PASS)
      echo "✓ verdict: Pass"
      pk_linear_set_state "$id" "$approved_state" || return 2
      echo
      echo "  ➜ next: pk branch $id"
      echo "VERDICT: Pass"
      ;;
    Revise|revise|REVISE)
      echo "✗ verdict: Revise"
      echo
      echo "  ➜ next: /02-light-spec-revise $id"
      echo "VERDICT: Revise"
      ;;
    *)
      echo "WARN: could not parse verdict from agent comment." >&2
      echo "  Inspect the comment manually on Linear." >&2
      echo "VERDICT: Malformed"
      return 1
      ;;
  esac
}

cmd_install() {
  local force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=true; shift ;;
      *) echo "pk install: unknown arg $1" >&2; return 2 ;;
    esac
  done

  # Resolve to realpath so re-invoking via the installed symlink still sees
  # the original source file and the idempotency check below works.
  local src raw
  raw="${BASH_SOURCE[0]}"
  if command -v realpath >/dev/null 2>&1; then
    src=$(realpath "$raw")
  else
    src="$(cd "$(dirname "$raw")" && pwd -P)/$(basename "$raw")"
    # Walk one symlink level if -P didn't resolve it (macOS bash 3 quirk)
    [ -L "$src" ] && src=$(cd "$(dirname "$src")" && cd "$(dirname "$(readlink "$src")")" && pwd -P)/$(basename "$(readlink "$src")")
  fi
  if [ ! -f "$src" ]; then
    echo "ERROR: cannot locate own script path." >&2
    return 1
  fi

  # Pick a writable bin directory on PATH. Prefer /usr/local/bin (universal),
  # fall back to ~/.local/bin (no sudo needed).
  local target_dir=""
  for d in /usr/local/bin "$HOME/.local/bin"; do
    if [ -d "$d" ] && [ -w "$d" ]; then
      target_dir="$d"
      break
    fi
    if [ "$d" = "$HOME/.local/bin" ] && [ ! -d "$d" ]; then
      mkdir -p "$d" && target_dir="$d" && break
    fi
  done
  if [ -z "$target_dir" ]; then
    echo "ERROR: no writable bin directory found." >&2
    echo "  Tried: /usr/local/bin, ~/.local/bin" >&2
    echo "  Try: sudo ln -s $src /usr/local/bin/pk" >&2
    return 1
  fi

  local target="$target_dir/pk"
  if [ -L "$target" ] || [ -e "$target" ]; then
    local existing
    existing=$(readlink "$target" 2>/dev/null || echo "$target")
    # v2.4.3: --force always re-links, even when the existing target already
    # points at $src. Previously the "already installed" check returned 0
    # before --force was evaluated, so `pk install --force` was a silent no-op
    # against valid symlinks. Anchor: Pendragon 2026-05-13, where rerunning
    # --force to refresh a stale lockstep did nothing.
    if [ "$existing" = "$src" ] && ! $force; then
      echo "Already installed: $target → $src"
      return 0
    fi
    if [ "$existing" != "$src" ] && ! $force; then
      echo "ERROR: $target exists and points elsewhere ($existing)." >&2
      echo "  Use 'pk install --force' to overwrite." >&2
      return 1
    fi
    rm -f "$target"
  fi

  ln -s "$src" "$target"
  if $force && [ -n "${existing:-}" ] && [ "$existing" = "$src" ]; then
    echo "Re-linked: $target → $src (--force)"
  else
    echo "Installed: $target → $src"
  fi

  case ":$PATH:" in
    *:"$target_dir":*) ;;
    *)
      echo ""
      echo "WARNING: $target_dir is not on \$PATH."
      echo "  Add to your shell rc: export PATH=\"$target_dir:\$PATH\""
      ;;
  esac
}

cmd_help() {
  cat <<EOF
pk — Pipekit v2 daily-loop dispatcher (v$PK_VERSION)

Subcommands:
  pk next                         What should I do now?
  pk status                       Quick triage of the Linear board + worktrees
  pk branch <ISSUE-ID>            Create worktree+branch, Linear → In Progress
  pk ship [--env=<env>] [--review] [--ready]  Push, gh pr create (Draft by default; --ready opens Ready), Linear → UAT. UAT = PR open on preview branch (pre-merge). Outside reviewers fire when you flip to Ready (pk ready) — see templates/ci/.
  pk ready [<ID>]                 Flip a Draft PR to Ready (fires outside reviewers). No Linear state change. Run from parent repo or feature branch.
  pk done [<ID>] [--merge]        Verify PR merged (or --merge to have pk run gh pr merge first), cleanup worktree+branch, Linear: UAT → In <FirstEnv> (or → Done for 1-tier). Run from parent repo (not worktree); run /pk-exit inside the worktree session first. --confirmed accepted for backward compat (no-op).
  pk verify                       Run the project's pre-deploy gate
  pk config [<key> [<default>]]   Read a V2 key from method.config.md; no args = dump all known keys
  pk promote <env> [--stash|--take-remote] [--confirmed] [--finish]  Two-phase: pk promote <env> opens the promote PR (WITs stay in source state); pk promote <env> --finish transitions WITs to target state after the PR merges. Conflict flags resolve local edits vs incoming source. Refuses if any bundled issue is in UAT (PR not yet merged) — pass --confirmed to override.
  pk delegate <ID> <prompt>       Post an @Linear-mentioned comment to invoke Linear Agent
  pk spec-cycle <ID>              Trigger Spec Review Agent v5, poll, dispatch on verdict
  pk doctor                       Diagnose v2 setup (config, env, deps)
  pk init                         Walkthrough config check + setup hints
  pk install [--force]            Symlink pk onto \$PATH (so 'pk' replaces './bin/pk')
  pk log                          Show journal for current feature branch
  pk help                         Show this help

All subcommands are idempotent. Recovery = rerun the command.

Config: method.config.md in repo root. v2 keys are optional (sensible defaults).
North star: safe and frictionless. Helps, never adds work.
EOF
}

cmd_doctor() {
  local fail=0
  local warn=0
  local linear_ok=false
  echo "── pk doctor ──"
  echo ""
  # Repo
  local root
  root=$(pk_repo_root || echo "")
  if [ -n "$root" ]; then
    echo "  ✓ Git repo: $root"
  else
    echo "  ✗ Not in a git repo"
    fail=$((fail+1))
  fi
  # Deps
  for tool in jq gh git curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "  ✓ $tool installed"
    else
      echo "  ✗ $tool missing"
      fail=$((fail+1))
    fi
  done
  # Config
  local cfg
  cfg=$(pk_config_path 2>/dev/null || echo "")
  if [ -n "$cfg" ] && [ -f "$cfg" ]; then
    echo "  ✓ method.config.md found"
  else
    echo "  ⚠ method.config.md missing — using defaults"
    warn=$((warn+1))
  fi
  # Linear key
  local key_var key
  key_var=$(pk_linear_api_key_var)
  key=$(pk_linear_api_key)
  if [ -n "$key" ]; then
    echo "  ✓ Linear API key set (\$$key_var)"
  else
    echo "  ✗ Linear API key not set — export $key_var=lin_api_…"
    fail=$((fail+1))
  fi
  # Linear team
  local team team_id
  team=$(pk_team_name)
  team_id=$(pk_team_id)
  if [ -n "$team" ]; then
    echo "  ✓ Linear team: $team"
  else
    echo "  ⚠ Linear team name missing in method.config.md"
    warn=$((warn+1))
  fi
  if [ -n "$team_id" ]; then
    echo "  ✓ Linear team ID set"
  else
    echo "  ⚠ Linear team ID missing — pk_linear_set_state may degrade"
    warn=$((warn+1))
  fi
  # Linear API ping
  if [ -n "$key" ]; then
    local resp viewer
    resp=$(pk_linear_gql 'query{viewer{name}}' 2>/dev/null || echo "")
    viewer=$(echo "$resp" | jq -r '.data.viewer.name // empty' 2>/dev/null)
    if [ -n "$viewer" ]; then
      echo "  ✓ Linear API reachable (viewer: $viewer)"
      linear_ok=true
    else
      local err_msg
      err_msg=$(echo "$resp" | jq -r '.errors[0]?.extensions?.userPresentableMessage // .errors[0]?.message // empty' 2>/dev/null)
      if [ -n "$err_msg" ]; then
        echo "  ✗ Linear API call failed: $err_msg"
      elif [ -n "$resp" ]; then
        local snippet
        snippet=$(echo "$resp" | tr '\n' ' ' | cut -c1-200)
        echo "  ✗ Linear API call failed (unexpected response): $snippet"
      else
        echo "  ✗ Linear API call failed (no response — check network/DNS/firewall)"
      fi
      fail=$((fail+1))
    fi
  fi
  # Integration branch
  echo "  • Integration branch: $(pk_integration_branch)"
  # Backend
  echo "  • Backend: $(pk_config "Backend" "vbw")"
  # Session logs (v2.1.2+ — replaces the retired bash Stop hook).
  if [ -n "$root" ] && [ -d "$root/Logs/Sessions" ]; then
    echo "  ✓ Logs/Sessions/ present"
  else
    echo "  ⚠ Logs/Sessions/ missing — pk init creates it. /pk-exit writes per-session entries."
    warn=$((warn+1))
  fi
  # Flag stale v2.0/v2.1 Stop hook artifacts if present.
  if [ -n "$root" ] && [ -f "$root/.claude/settings.json" ] && grep -q "pipekit-journal-hook" "$root/.claude/settings.json" 2>/dev/null; then
    echo "  ⚠ stale 'pipekit-journal-hook' Stop hook in .claude/settings.json — retired in v2.1.2"
    warn=$((warn+1))
  fi
  if [ -n "$root" ] && [ -f "$root/scripts/pipekit-journal-hook.sh" ]; then
    echo "  ⚠ stale scripts/pipekit-journal-hook.sh — retired in v2.1.2; safe to delete"
    warn=$((warn+1))
  fi

  # --- Linear↔git integrity (false-ship detection) -----------------------
  # For WITs the board calls built/shipped (UAT, Done), confirm git history
  # actually contains implementation referencing the id. A Done/UAT issue with
  # no commits — or only docs commits — is a likely false-ship (marked complete
  # but never built). Advisory: this is a grep heuristic that assumes commits/
  # merges reference the WIT id (feature/<ID>-slug convention), so it surfaces
  # candidates for human review and never hard-fails. Mirror of /strategy-sync
  # 4b, which catches the opposite drift (merged-but-not-Done).
  if [ "$linear_ok" = true ] && [ -n "$root" ]; then
    echo ""
    echo "── Linear↔git integrity (built-state cross-check) ──"
    local integ ref st issues ids id ev checked=0 suspect=0
    integ=$(pk_integration_branch)
    ref="HEAD"
    if [ -n "$integ" ]; then
      if git rev-parse --verify --quiet "origin/$integ" >/dev/null 2>&1; then
        ref="origin/$integ"
      elif git rev-parse --verify --quiet "$integ" >/dev/null 2>&1; then
        ref="$integ"
      fi
    fi
    echo "  (commits reachable from $ref)"
    for st in "UAT" "Done"; do
      issues=$(pk_linear_issues_in_state "$st" 2>/dev/null || echo "[]")
      ids=$(echo "$issues" | jq -r '.[].identifier // empty' 2>/dev/null || true)
      [ -n "$ids" ] || continue
      while IFS= read -r id; do
        [ -n "$id" ] || continue
        checked=$((checked+1))
        ev=$(pk_git_build_evidence "$id" "$ref")
        case "$ev" in
          none)      echo "  ⚠ $st $id — no commits reference it on $ref (possible false-ship)"; suspect=$((suspect+1)) ;;
          docs-only) echo "  ⚠ $st $id — only docs commits reference it (no implementation found)"; suspect=$((suspect+1)) ;;
        esac
      done <<< "$ids"
    done
    if [ "$checked" -eq 0 ]; then
      echo "  • no UAT/Done issues to check"
    elif [ "$suspect" -eq 0 ]; then
      echo "  ✓ all $checked built-state issue(s) have implementation commits"
    else
      echo "  → $suspect of $checked flagged. Heuristic (assumes commits reference the id);"
      echo "    verify with: git log --all --grep=<ID> before reopening."
      warn=$((warn+1))
    fi
  fi

  echo ""
  if [ $fail -gt 0 ]; then
    echo "Result: $fail error(s), $warn warning(s). Fix errors before using pk."
    return 1
  fi
  if [ $warn -gt 0 ]; then
    echo "Result: $warn warning(s). pk should work but check the items above."
  else
    echo "Result: all green. pk is ready."
  fi
}

cmd_version() {
  echo "pk $PK_VERSION"
}

# pk config <key> [default]   → print value (suitable for $() substitution)
# pk config                   → dump every known V2 key + its resolved value
cmd_config() {
  if [ $# -ge 1 ]; then
    pk_config "$1" "${2:-}"
    return 0
  fi
  local path
  path=$(pk_config_path) || { echo "ERROR: not in a git repo." >&2; return 1; }
  if [ ! -f "$path" ]; then
    echo "ERROR: $path not found." >&2
    return 1
  fi
  local key
  for key in \
    "Backend" \
    "Integration branch" \
    "Promote to main" \
    "Require QA review" \
    "Default deep flag" \
    "Ship environments" \
    "Linear API key env var" \
    "Migration dir" \
    "Spec ready state" \
    "Spec approved state" \
    "Self-reference check" \
    "Source root" \
    "Worktree prefix"; do
    printf '%-24s %s\n' "$key:" "$(pk_config "$key" "")"
  done
}

# ─────────────────────────────────────────────────────────────────────────────
# Dispatcher
# ─────────────────────────────────────────────────────────────────────────────

main() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required. Install: brew install jq" >&2
    exit 1
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "ERROR: gh CLI is required. Install: brew install gh" >&2
    exit 1
  fi

  local sub="${1:-help}"
  shift || true
  case "$sub" in
    next)     cmd_next "$@" ;;
    status)   cmd_status "$@" ;;
    branch)   cmd_branch "$@" ;;
    ship)     cmd_ship "$@" ;;
    ready)    cmd_ready "$@" ;;
    done)     cmd_done "$@" ;;
    verify)   cmd_verify "$@" ;;
    config|cfg) cmd_config "$@" ;;
    promote)  cmd_promote "$@" ;;
    delegate) cmd_delegate "$@" ;;
    spec-cycle) cmd_spec_cycle "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    init)     cmd_init "$@" ;;
    install)  cmd_install "$@" ;;
    log)      cmd_log "$@" ;;
    help|-h|--help) cmd_help ;;
    version|-v|--version) cmd_version ;;
    *) echo "Unknown subcommand: $sub" >&2; cmd_help; exit 1 ;;
  esac
}

# Skip main when sourced (lets tests exercise helpers like pk_config directly).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
